#version 450
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_ARB_shading_language_include : enable
#extension GL_ARB_gpu_shader_int64 : enable

#include "../../includes/globalset.shader"

#define GROUP_DIM 8
#define BLUR_RADIUS 8
#define CACHE_DIM (GROUP_DIM + 2 * BLUR_RADIUS)
layout(local_size_x = GROUP_DIM, local_size_y = GROUP_DIM, local_size_z = 1) in;

layout(push_constant) uniform Constants {
    vec2 Direction;  // (1,0) or (0,1)
    vec2 TextureSize;
    int imageInput;
    int imageOutput;
}

pc;


shared vec3 g_Cache[CACHE_DIM][CACHE_DIM];

void main() {
    ivec2 centerBase      = ivec2(gl_WorkGroupID.xy * GROUP_DIM) - ivec2(BLUR_RADIUS);
    uint threadIndex      = gl_LocalInvocationID.y * GROUP_DIM + gl_LocalInvocationID.x;
    uint totalCachePixels = CACHE_DIM * CACHE_DIM;
    uint groupSize        = GROUP_DIM * GROUP_DIM;
    for (uint i = threadIndex; i < totalCachePixels; i += groupSize) {
        int cacheX              = int(i % CACHE_DIM);
        int cacheY              = int(i / CACHE_DIM);
        ivec2 pixelPos          = centerBase + ivec2(cacheX, cacheY);
        pixelPos                = clamp(pixelPos, ivec2(0), ivec2(pc.TextureSize) - 1);
        g_Cache[cacheY][cacheX] = texelFetch(sampler2D(textures[pc.imageInput], samplers[SAMPLER_LINEAR]), pixelPos, 0).rgb;
    }

    barrier();

    // 2. Perform Blur (Corrected for any Radius)
    // ----------------------------------------
    if (gl_GlobalInvocationID.x < uint(pc.TextureSize.x) && gl_GlobalInvocationID.y < uint(pc.TextureSize.y)) {

        ivec2 localPos = ivec2(gl_LocalInvocationID.xy) + ivec2(BLUR_RADIUS);
        ivec2 dir = ivec2(pc.Direction);

        vec3  result = vec3(0.0);
        float totalWeight = 0.0;

        // Calculate Sigma based on radius (controls the spread)
        // A common rule of thumb is sigma = radius / 2.0
        float sigma = max(float(BLUR_RADIUS) / 2.0, 0.0001);
        float k = 2.0 * sigma * sigma; // Optimization constant

        // Convolve
        for (int i = -BLUR_RADIUS; i <= BLUR_RADIUS; ++i) {

            // Calculate Gaussian weight dynamically: e^(-x^2 / 2sigma^2)
            float w = exp( -float(i * i) / k );

            ivec2 offset = ivec2(i) * dir;
            ivec2 samplePos = localPos + offset;

            // Accumulate
            result += g_Cache[samplePos.y][samplePos.x] * w;
            totalWeight += w;
        }

        // Normalize (ensure brightness doesn't change)
        imageStore(storageImages[pc.imageOutput], ivec2(gl_GlobalInvocationID.xy), vec4(result / totalWeight, 1.0));
    }
}