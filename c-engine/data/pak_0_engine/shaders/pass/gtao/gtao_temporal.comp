#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_ARB_shading_language_include : enable

#include "../../includes/globalset.shader"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint  currentIndex;
    uint  historyIndex;
    uint  velocityIndex;
    uint  depthIndex;
    uint  normalIndex;
    uint  outputIndex;
    uint  width;
    uint  height;
    uint  historyValid;
    float jitterDeltaX;
    float jitterDeltaY;
    uint  frameIndex;
} pc;

float linearizeDepth(float d) {
    float N = sceneBuffer.cameras[0].zNear;
    float F = sceneBuffer.cameras[0].zFar;
    return (2.0 * N * F) / max((F - N) * d + N + F, 1e-7);
}

vec3 loadNormal(ivec2 coord) {
    vec2 nxy = texelFetch(sampler2D(textures[nonuniformEXT(pc.normalIndex)],
                                    samplers[SAMPLER_NEAREST]),
                          coord, 0).rg;
    return vec3(nxy, sqrt(max(1.0 - dot(nxy, nxy), 0.0)));
}

void main() {
    ivec2 coord   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 fullCoord = coord * 2;
    if (fullCoord.x >= int(pc.width) || fullCoord.y >= int(pc.height)) return;

    /* Half-res GTAo current frame. */
    float current = texelFetch(sampler2D(textures[nonuniformEXT(pc.currentIndex)],
                                         samplers[SAMPLER_NEAREST]),
                               coord, 0).r;

    /* Full-res depth/normal. */
    float centerDepth = texelFetch(sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                                             samplers[SAMPLER_NEAREST]),
                                   fullCoord, 0).r;
    if (centerDepth == 0.0 || pc.historyValid == 0u) {
        imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord,
                   vec4(current, 0.0, 0.0, 1.0));
        return;
    }

    vec3  centerNormal = loadNormal(fullCoord);
    float centerLinZ   = linearizeDepth(centerDepth);

    /* Single 3x3 pass: velocity dilation + thin-geometry + edge detection.
     * Reduced from 5x5 (25 reads) to 3x3 (9 reads).
     * Offsets doubled for full-res depth access. */
    float bestDepth = 0.0;
    ivec2 bestOff   = ivec2(0);
    float depthGrad = 0.0;
    float edgeCount = 0.0;
    int   validCount = 0;

    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 sc = clamp(fullCoord + ivec2(x * 2, y * 2),
                             ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
            float sd = texelFetch(sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                                           samplers[SAMPLER_NEAREST]),
                                 sc, 0).r;

            /* Closest-depth velocity dilation. */
            if (sd > bestDepth) {
                bestDepth = sd;
                bestOff   = ivec2(x, y);
            }
            if (x == 0 && y == 0) continue;
            if (sd > 0.0) {
                depthGrad += abs(centerLinZ - linearizeDepth(sd));
                validCount++;
            } else {
                edgeCount += 1.0;
            }
        }
    }

    /* Velocity: full-res texture. */
    ivec2 velCoord = clamp(fullCoord + bestOff * 2,
                           ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
    vec2 velocity = texelFetch(sampler2D(textures[nonuniformEXT(pc.velocityIndex)],
                                         samplers[SAMPLER_NEAREST]),
                               velCoord, 0).rg;

    /* UV in full-res space (consistent velocity displacement). */
    vec2 size = vec2(float(pc.width), float(pc.height));
    vec2 uv   = (vec2(fullCoord) + 0.5) / size;

    /* Classification from merged pass. */
    float isThinGeometry = 0.0;
    if (validCount > 0) {
        float relDepthGrad = (depthGrad / float(validCount)) / max(centerLinZ, 1e-4);
        isThinGeometry = smoothstep(0.01, 0.06, relDepthGrad);
    }
    float edgeWeight = edgeCount / 9.0;
    float isEdge = smoothstep(0.0, 0.5, edgeWeight) * smoothstep(0.3, 0.8, isThinGeometry);

    /* Jitter-corrected history UV. */
    float jitterFactor = mix(1.0, 0.0, isThinGeometry);
    vec2 historyUV = uv - velocity / size +
                     vec2(pc.jitterDeltaX, pc.jitterDeltaY) * jitterFactor;

    if (historyUV.x < 0.0 || historyUV.x > 1.0 || historyUV.y < 0.0 || historyUV.y > 1.0) {
        imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord,
                   vec4(current, 0.0, 0.0, 1.0));
        return;
    }

    /* History depth/normal at full-res UV. */
    ivec2 historyCoord = clamp(ivec2(historyUV * size),
                               ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));

    float historyDepth = texelFetch(sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                                              samplers[SAMPLER_NEAREST]),
                                    historyCoord, 0).r;
    if (historyDepth == 0.0) {
        imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord,
                   vec4(current, 0.0, 0.0, 1.0));
        return;
    }

    vec3  historyNormal = loadNormal(historyCoord);
    float historyLinZ   = linearizeDepth(historyDepth);
    float relDepthDiff  = abs(centerLinZ - historyLinZ) / max(max(centerLinZ, historyLinZ), 1e-4);
    float normalMatch   = dot(centerNormal, historyNormal);

    /* Half-res history texture sampled at full-res UV (0..1 range). */
    float history = texture(sampler2D(textures[nonuniformEXT(pc.historyIndex)],
                                      samplers[SAMPLER_CLAMP_LINEAR]),
                            historyUV).r;

    /* Neighbourhood variance clamp — half-res GTAo neighbors. */
    float aoMin   = current;
    float aoMax   = current;
    float aoSum   = current;
    float aoSqSum = current * current;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            if (x == 0 && y == 0) continue;
            ivec2 sc = clamp(coord + ivec2(x, y),
                             ivec2(0), ivec2((int(pc.width) + 1) / 2 - 1,
                                             (int(pc.height) + 1) / 2 - 1));
            float sao = texelFetch(sampler2D(textures[nonuniformEXT(pc.currentIndex)],
                                             samplers[SAMPLER_NEAREST]),
                                   sc, 0).r;
            aoMin    = min(aoMin, sao);
            aoMax    = max(aoMax, sao);
            aoSum   += sao;
            aoSqSum += sao * sao;
        }
    }

    float speed = length(velocity);

    /* Variance-based soft clamp with thin-geometry awareness. */
    float thinGamma = mix(1.0, 5.0, isThinGeometry);
    float edgeGamma = mix(1.0, 6.0, isEdge);
    float aoMean    = aoSum / 9.0;
    float aoVariance = max(aoSqSum / 9.0 - aoMean * aoMean, 0.0);
    float aoSigma    = sqrt(aoVariance);
    float gamma      = mix(mix(1.0, 2.5, smoothstep(0.5, 4.0, speed)),
                           thinGamma, isThinGeometry);
    gamma            = max(gamma, edgeGamma * isEdge);
    float varMin     = max(aoMean - gamma * aoSigma, aoMin);
    float varMax     = min(aoMean + gamma * aoSigma, aoMax);

    history = clamp(history, varMin, varMax);

    /* Disocclusion detection. */
    float disocclusion = smoothstep(0.01, 0.08, relDepthDiff) +
                         (1.0 - smoothstep(0.90, 0.99, normalMatch));
    disocclusion = clamp(disocclusion, 0.0, 1.0);
    disocclusion *= mix(1.0, 0.02, isThinGeometry);
    disocclusion *= mix(1.0, 0.01, isEdge);

    /* Temporal blend. */
    float baseBlend = mix(0.02, 0.005, isThinGeometry);
    float velocityWeight = smoothstep(0.5, 4.0, speed) * 0.05;
    float blend = min(max(baseBlend, disocclusion + velocityWeight), 0.05);

    float result = mix(history, current, clamp(blend, 0.0, 1.0));
    imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord,
               vec4(clamp(result, 0.0, 1.0), 0.0, 0.0, 1.0));
}
