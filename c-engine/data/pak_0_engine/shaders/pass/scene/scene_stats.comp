#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_ARB_shading_language_include : enable

layout(local_size_x = 64) in;

layout(push_constant) uniform PushConstants {
    uint64_t drawInstanceBufferAddress;
    uint64_t culledBufferAddress;
    uint64_t countBufferAddress;
    uint64_t statsBufferAddress;
    uint maxDrawInstances;
};

struct GpuDrawInstance {
    uint firstIndex;
    uint indexCount;
    int vertexOffset;
    uint entity;
    uint materialId;
    uint flags;
    uint _pad0;
    uint _pad1;
    vec4 boundingSphere;
};

layout(buffer_reference, std430) buffer DrawInstanceBuffer {
    GpuDrawInstance instances[];
};

layout(buffer_reference, std430) buffer CulledBuffer {
    uint culledIndices[];
};

layout(buffer_reference, std430) buffer CountBuffer {
    uint count;
};

layout(buffer_reference, std430) buffer StatsBuffer {
    uint drawCalls;
    uint triangleCount;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;

    CountBuffer countBuf = CountBuffer(countBufferAddress);
    uint count = countBuf.count;
    if (idx >= count) return;

    CulledBuffer culledBuf = CulledBuffer(culledBufferAddress);
    uint instanceIdx = culledBuf.culledIndices[idx];

    DrawInstanceBuffer instBuf = DrawInstanceBuffer(drawInstanceBufferAddress);
    GpuDrawInstance inst = instBuf.instances[instanceIdx];

    StatsBuffer statsBuf = StatsBuffer(statsBufferAddress);
    atomicAdd(statsBuf.drawCalls, 1u);
    atomicAdd(statsBuf.triangleCount, inst.indexCount / 3u);
}
