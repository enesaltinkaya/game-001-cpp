#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_ARB_shading_language_include : enable

layout(local_size_x = 64) in;

layout(push_constant) uniform PushConstants {
    uint64_t drawInstanceBufferAddress;
    uint64_t transformBufferAddress;
    uint64_t indirectBufferAddress;
    uint64_t culledBufferAddress;
    uint64_t drawCountBufferAddress;
    uint64_t dsIndirectBufferAddress;
    uint64_t dsCulledBufferAddress;
    uint64_t dsDrawCountBufferAddress;
    uint64_t transIndirectBufferAddress;
    uint64_t transCulledBufferAddress;
    uint64_t transDrawCountBufferAddress;
    uint64_t visibilityBufferAddress;
    uint maxDrawInstances;
    uint hizTextureIndex;
};

#include "../../includes/utils.shader"
#include "../../includes/globalset.shader"

TransformBufferRef transformBuffer = TransformBufferRef(transformBufferAddress);

#define DRAW_FLAG_DOUBLE_SIDED 1u
#define DRAW_FLAG_TRANSPARENT 2u

struct GpuDrawInstance {
    uint firstIndex;
    uint indexCount;
    int vertexOffset;
    uint entity;
    uint materialId;
    uint flags;
    uint _pad0;
    uint _pad1;
    vec4 boundingSphere;
};

struct DrawIndexedCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(buffer_reference, std430) buffer DrawInstanceBuffer {
    GpuDrawInstance instances[];
};

layout(buffer_reference, std430) buffer IndirectBuffer {
    DrawIndexedCommand commands[];
};

layout(buffer_reference, std430) buffer CulledBuffer {
    uint culledIndices[];
};

layout(buffer_reference, std430) buffer DrawCountBuffer {
    uint count;
};

layout(buffer_reference, std430) buffer VisibilityBuffer {
    uint flags[];
};

bool frustumCull(vec3 worldCenter, float worldRadius) {
    vec4 planes[6] = sceneBuffer.cameras[0].frustumPlanes;

    for (int i = 0; i < 6; i++) {
        if (dot(planes[i].xyz, worldCenter) + planes[i].w < -worldRadius) {
            return true;
        }
    }

    return false;
}

// Returns true if the object is occluded by the previous frame's Hi-Z buffer
bool hizOcclusionCull(vec3 worldCenter, float worldRadius) {
    if (hizTextureIndex == 0xFFFFFFFF) return false;

    mat4 viewProj = sceneBuffer.cameras[0].viewProjection;

    vec3 boundsMin = worldCenter - vec3(worldRadius);
    vec3 boundsMax = worldCenter + vec3(worldRadius);

    vec4 corners[8] = {vec4(boundsMin.x, boundsMin.y, boundsMin.z, 1.0),
                       vec4(boundsMax.x, boundsMin.y, boundsMin.z, 1.0),
                       vec4(boundsMin.x, boundsMax.y, boundsMin.z, 1.0),
                       vec4(boundsMax.x, boundsMax.y, boundsMin.z, 1.0),
                       vec4(boundsMin.x, boundsMin.y, boundsMax.z, 1.0),
                       vec4(boundsMax.x, boundsMin.y, boundsMax.z, 1.0),
                       vec4(boundsMin.x, boundsMax.y, boundsMax.z, 1.0),
                       vec4(boundsMax.x, boundsMax.y, boundsMax.z, 1.0)};

    vec2 minXY     = vec2(1.0);
    vec2 maxXY     = vec2(-1.0);
    float nearestZ = 0.0;
    bool crossNear = false;

    for (int i = 0; i < 8; i++) {
        vec4 clip = viewProj * corners[i];
        if (clip.w <= 0.0) {
            crossNear = true;
            break;
        }
        vec3 ndc = clip.xyz / clip.w;
        minXY    = min(minXY, ndc.xy);
        maxXY    = max(maxXY, ndc.xy);
        nearestZ = max(nearestZ, ndc.z);
    }

    if (crossNear) return false;  // straddles near plane — can't cull

    // NDC → UV
    vec2 uvMin = vec2(minXY.x * 0.5 + 0.5, maxXY.y * -0.5 + 0.5);
    vec2 uvMax = vec2(maxXY.x * 0.5 + 0.5, minXY.y * -0.5 + 0.5);
    uvMin      = clamp(uvMin, 0.0, 1.0);
    uvMax      = clamp(uvMax, 0.0, 1.0);

    vec2 size      = (uvMax - uvMin) * sceneBuffer.cameras[0].viewport;
    float mipLevel = ceil(log2(max(max(size.x, size.y), 1.0))) + 1.0;

    // Sample the Hi-Z at the 4 corners of the projected AABB
    float d0 = textureLod(sampler2D(textures[hizTextureIndex], samplers[SAMPLER_NEAREST]),
                          vec2(uvMin.x, uvMin.y),
                          mipLevel)
                   .r;
    float d1 = textureLod(sampler2D(textures[hizTextureIndex], samplers[SAMPLER_NEAREST]),
                          vec2(uvMax.x, uvMin.y),
                          mipLevel)
                   .r;
    float d2 = textureLod(sampler2D(textures[hizTextureIndex], samplers[SAMPLER_NEAREST]),
                          vec2(uvMin.x, uvMax.y),
                          mipLevel)
                   .r;
    float d3 = textureLod(sampler2D(textures[hizTextureIndex], samplers[SAMPLER_NEAREST]),
                          vec2(uvMax.x, uvMax.y),
                          mipLevel)
                   .r;

    // Reverse-Z: .r = min (farthest depth). Object's nearest Z must be greater
    // than the farthest depth in the Hi-Z to be occluded.
    float minHiZ = min(min(d0, d1), min(d2, d3));

    return nearestZ < minHiZ;
}

// Returns true if the bounding sphere overlaps any shadow cascade frustum.
// Uses generous bounds (±1.5 XY, [-0.5,1.5] Z) to avoid falsely rejecting
// shadow casters near cascade boundaries.
bool isInAnyShadowCascade(vec3 worldCenter, float worldRadius) {
    for (int c = 0; c < int(sceneBuffer.shadow.cascadeCount); c++) {
        mat4 svp = sceneBuffer.shadow.shadowViewProjection[c];
        vec4 clip = svp * vec4(worldCenter, 1.0);

        float rx = worldRadius * length(vec3(svp[0][0], svp[1][0], svp[2][0]));
        float ry = worldRadius * length(vec3(svp[0][1], svp[1][1], svp[2][1]));
        float rz = worldRadius * length(vec3(svp[0][2], svp[1][2], svp[2][2]));

        if (clip.x + rx >= -1.5 && clip.x - rx <= 1.5 &&
            clip.y + ry >= -1.5 && clip.y - ry <= 1.5 &&
            clip.z + rz >= -0.5 && clip.z - rz <= 1.5) {
            return true;
        }
    }
    return false;
}

void main() {
    uint instanceIndex = gl_GlobalInvocationID.x;
    if (instanceIndex >= maxDrawInstances) return;

    DrawInstanceBuffer instBuf = DrawInstanceBuffer(drawInstanceBufferAddress);
    GpuDrawInstance inst       = instBuf.instances[instanceIndex];

    // Transform bounding sphere to world space
    Transform transform = transformBuffer.transforms[inst.entity];
    vec3 worldCenter    = transformVertex(inst.boundingSphere.xyz,
                                          transform.pos.xyz,
                                          transform.rot,
                                          vec3(transform.pos.w));
    float worldRadius   = inst.boundingSphere.w * abs(transform.pos.w);

    VisibilityBuffer visBuf = VisibilityBuffer(visibilityBufferAddress);

    // Frustum culling (with shadow cascade awareness)
    if (frustumCull(worldCenter, worldRadius)) {
        if (!isInAnyShadowCascade(worldCenter, worldRadius)) {
            visBuf.flags[instanceIndex] = 0u;  // frustum-culled
            return;
        }
    }

    bool isCameraOccluder    = cameraOccluderAlpha(inst.entity) < CAMERA_OCCLUDER_ACTIVE_ALPHA;
    bool isTransparent       = (inst.flags & DRAW_FLAG_TRANSPARENT) != 0u;
    bool isDoubleSided       = (inst.flags & DRAW_FLAG_DOUBLE_SIDED) != 0u;
    bool rendersTransparent  = isTransparent || isCameraOccluder;

    // Skip HiZ occlusion culling for shadow casters and transparent camera
    // occluders.  Camera occluders must always reach OIT so they can fade
    // instead of disappearing behind the previous frame's depth pyramid.
    bool needsShadow = isInAnyShadowCascade(worldCenter, worldRadius);
    if (!needsShadow && !rendersTransparent && hizOcclusionCull(worldCenter, worldRadius)) {
        visBuf.flags[instanceIndex] = 2u;  // occlusion-rejected, retry in phase 2
        return;
    }

    visBuf.flags[instanceIndex] = 1u;  // visible

    // Dynamic camera occluders need two classifications:
    // - transparent/OIT for color, using cameraOccluderAlpha()
    // - their normal opaque/double-sided bucket for shadow maps.  The scene
    //   color/depth shaders discard them from the opaque pass, but the shadow
    //   shaders do not, so they keep casting normal shadows while faded.
    if (isCameraOccluder && !isTransparent) {
        uint visibleIndex = atomicAdd(DrawCountBuffer(transDrawCountBufferAddress).count, 1);

        CulledBuffer transCulledBuf                = CulledBuffer(transCulledBufferAddress);
        transCulledBuf.culledIndices[visibleIndex] = instanceIndex;

        IndirectBuffer transIndirectBuf                       = IndirectBuffer(transIndirectBufferAddress);
        transIndirectBuf.commands[visibleIndex].indexCount    = inst.indexCount;
        transIndirectBuf.commands[visibleIndex].instanceCount = 1;
        transIndirectBuf.commands[visibleIndex].firstIndex    = inst.firstIndex;
        transIndirectBuf.commands[visibleIndex].vertexOffset  = inst.vertexOffset;
        transIndirectBuf.commands[visibleIndex].firstInstance = 0;
    }

    // Classify by original material flags for opaque/depth/shadow rendering.
    uint64_t targetIndirectAddr;
    uint64_t targetCulledAddr;
    uint64_t targetDrawCountAddr;

    if (isTransparent) {
        targetIndirectAddr  = transIndirectBufferAddress;
        targetCulledAddr    = transCulledBufferAddress;
        targetDrawCountAddr = transDrawCountBufferAddress;
    } else if (isDoubleSided) {
        targetIndirectAddr  = dsIndirectBufferAddress;
        targetCulledAddr    = dsCulledBufferAddress;
        targetDrawCountAddr = dsDrawCountBufferAddress;
    } else {
        targetIndirectAddr  = indirectBufferAddress;
        targetCulledAddr    = culledBufferAddress;
        targetDrawCountAddr = drawCountBufferAddress;
    }

    uint visibleIndex = atomicAdd(DrawCountBuffer(targetDrawCountAddr).count, 1);

    CulledBuffer culledBuf                = CulledBuffer(targetCulledAddr);
    culledBuf.culledIndices[visibleIndex] = instanceIndex;

    IndirectBuffer indirectBuf                       = IndirectBuffer(targetIndirectAddr);
    indirectBuf.commands[visibleIndex].indexCount    = inst.indexCount;
    indirectBuf.commands[visibleIndex].instanceCount = 1;
    indirectBuf.commands[visibleIndex].firstIndex    = inst.firstIndex;
    indirectBuf.commands[visibleIndex].vertexOffset  = inst.vertexOffset;
    indirectBuf.commands[visibleIndex].firstInstance = 0;
}
