#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_ARB_shading_language_include : enable

#include "../../includes/utils.shader"
#include "../../includes/globalset.shader"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint opaqueColorIndex;    // SceneColor (sampled) — opaque + skybox
    uint compositeColorIndex; // CompositeColor (sampled) — opaque + reflections + AO
    uint reactiveMaskIndex;   // reactive mask (storage, R32F)
    uint width;
    uint height;
    uint materialIndex;       // G-buffer material (sampled, R8G8B8A8: roughness, metallic, alphaMask, unused)
    uint depthIndex;          // depth buffer (sampled, D32)
    uint normalsIndex;        // G-buffer normals (sampled, R16G16: oct-encoded)
    uint tcMaskIndex;         // transparency & composition mask (storage, R32F)
} pc;

const vec3 kLumW = vec3(0.2126, 0.7152, 0.0722);

ivec2 clampCoord(ivec2 coord) {
    return clamp(coord, ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
}

float fetchDepth(ivec2 coord) {
    return texelFetch(
        sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                  samplers[SAMPLER_NEAREST]),
        clampCoord(coord), 0).r;
}

vec3 fetchOpaque(ivec2 coord) {
    return texelFetch(
        sampler2D(textures[nonuniformEXT(pc.opaqueColorIndex)],
                  samplers[SAMPLER_NEAREST]),
        clampCoord(coord), 0).rgb;
}

vec3 fetchWorldNormal(ivec2 coord) {
    vec2 normEnc = texelFetch(
        sampler2D(textures[nonuniformEXT(pc.normalsIndex)],
                  samplers[SAMPLER_NEAREST]),
        clampCoord(coord), 0).rg;
    return OctDecode(normEnc);
}

float luminance(vec3 rgb) {
    return dot(rgb, kLumW);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(pc.width, pc.height);

    /* ── Skip sky pixels ──────────────────────────────────────────── */
    float depth = fetchDepth(coord);
    if (depth == 0.0) {
        imageStore(storageImages[nonuniformEXT(pc.reactiveMaskIndex)],
                   coord, vec4(0.0));
        imageStore(storageImages[nonuniformEXT(pc.tcMaskIndex)],
                   coord, vec4(0.0));
        return;
    }

    /* ── Read G-buffers ───────────────────────────────────────────── */
    vec4 matData = texelFetch(
        sampler2D(textures[nonuniformEXT(pc.materialIndex)],
                  samplers[SAMPLER_NEAREST]),
        coord, 0);
    float roughness  = matData.r;
    float metallic   = matData.g;
    float isAlphaCut = matData.b;   /* 1.0 when MAT_ALPHA_MASK is set */

    vec3 worldN = fetchWorldNormal(coord);

    /* ── Reconstruct world position & view direction ──────────────── */
    // Use unjittered inverse VP for temporally stable world positions.
    // Subtract jitter from UV since depth was rasterised with jittered projection.
    vec2 unjitteredUv = uv + vec2(sceneBuffer.cameras[0].jitterX,
                                   sceneBuffer.cameras[0].jitterY);
    vec2 ndc      = vec2(unjitteredUv.x * 2.0 - 1.0, 1.0 - unjitteredUv.y * 2.0);
    vec4 worldH   = sceneBuffer.cameras[0].invViewProjectionNoJitter * vec4(ndc, depth, 1.0);
    vec3 worldPosDepth = worldH.xyz / worldH.w;
    vec3 worldPos = worldPosDepth;

    vec3 viewPos = (sceneBuffer.cameras[0].view * vec4(worldPos, 1.0)).xyz;
    vec3 viewDir = normalize(viewPos);
    vec3 viewN   = normalize(mat3(sceneBuffer.cameras[0].view) * worldN);
    float NdotV  = max(dot(-viewDir, viewN), 0.0);

    /* ── 1. Planar-reflection reactivity ──────────────────────────── */
    float reflReactive = 0.0;
    {
        const vec3  planeN = vec3(0.0, 1.0, 0.0);
        float planeOffset = 0.0;
        float planeDist   = abs(dot(worldPosDepth, planeN) + planeOffset);

        if (planeDist < 0.40) {
            vec4 farWorldH = sceneBuffer.cameras[0].invViewProjectionNoJitter * vec4(ndc, 0.0, 1.0);
            vec3 farWorld  = farWorldH.xyz / farWorldH.w;
            vec3 camPos    = sceneBuffer.cameras[0].position.xyz;
            vec3 rayDir    = normalize(farWorld - camPos);
            float denom    = dot(rayDir, planeN);
            if (abs(denom) > 1e-5) {
                float t = -(dot(camPos, planeN) + planeOffset) / denom;
                if (t > 0.0) {
                    worldPos = camPos + rayDir * t;
                }
            }

            float smoothness = 1.0 - smoothstep(0.0, 0.50, roughness);
            float alignment  = 1.0 - smoothstep(0.05, 0.40, planeDist);
            reflReactive = smoothness * alignment * 0.015;
        }
    }

    /* ── 2. Specular / view-dependent reactivity ──────────────────── */
    float specReactive = 0.0;
    if (reflReactive <= 0.0)
    {
        float specBase = smoothstep(0.20, 0.25, roughness) *
                         (1.0 - smoothstep(0.35, 0.40, roughness));
        if (specBase > 0.0) {
            float grazingBoost = pow(clamp(1.0 - NdotV, 0.0, 1.0), 5.0);
            specReactive = specBase * mix(0.02, 0.06, grazingBoost);
            specReactive = mix(specReactive,
                               min(specReactive + 0.01, 0.08),
                               metallic);
        }
    }

    /* ── 3. Composite-difference fallback ─────────────────────────── */
    float compReactive = 0.0;
    if (reflReactive <= 0.0 && roughness >= 0.25)
    {
        vec3 opaque    = fetchOpaque(coord);
        vec3 composite = texture(
            sampler2D(textures[nonuniformEXT(pc.compositeColorIndex)],
                      samplers[SAMPLER_CLAMP_LINEAR]),
            uv).rgb;
        float lumO   = luminance(opaque);
        float lumC   = luminance(composite);
        float relDiff = abs(lumC - lumO) / max(max(lumC, lumO), 0.02);
        compReactive  = smoothstep(0.10, 0.30, relDiff) * 0.25;
    }

    /* ── 4. Alpha-cutout edge detection ──────────────────────────────────
     *
     * Alpha-cutout edges (grass, foliage) move in sub-pixel steps as the
     * camera moves, causing FSR's temporal accumulator to see alternating
     * grass/background colors at edge pixels.  Testing showed that reactive
     * and TC masks for alpha-cutout pixels are counterproductive — they
     * either force accumulation reset (causing shimmer) or add noise that
     * overrides FSR's built-in disocclusion detection.
     *
     * FSR's default temporal accumulation handles these edges reasonably
     * well through its internal shading change tracking.  Alpha-cutout
     * detection is intentionally left disabled. */
    float alphaCutReactive = 0.0;
    float alphaCutTC = 0.0;

    /* ── 5. Terrain at grazing angles ─────────────────────────────── */
    float terrainReactive = 0.0;
    {
        float upFacing = max(dot(worldN, vec3(0.0, 1.0, 0.0)), 0.0);
        if (reflReactive <= 0.0 && roughness >= 0.25 &&
            upFacing > 0.7 && metallic < 0.1) {
            float grazing = pow(clamp(1.0 - NdotV, 0.0, 1.0), 3.0);
            terrainReactive = grazing * 0.4;
        }
    }

    /* ── Combine ──────────────────────────────────────────────────── */
    float reactive = max(reflReactive,
                         max(specReactive,
                         max(compReactive,
                         max(terrainReactive, alphaCutReactive))));
    /* Allow full suppression (1.0) for alpha-cutout pixels.  The old
     * 0.95 clamp prevented FSR3 from fully disabling accumulation,
     * which caused persistent shimmer on alpha-cutout edges. */
    reactive = clamp(reactive, 0.0, 1.0);

    float tc = max(reflReactive * 0.03, compReactive * 0.3);
    tc = max(tc, alphaCutTC);

    imageStore(storageImages[nonuniformEXT(pc.reactiveMaskIndex)],
               coord, vec4(reactive, 0.0, 0.0, 0.0));
    imageStore(storageImages[nonuniformEXT(pc.tcMaskIndex)],
               coord, vec4(tc, 0.0, 0.0, 0.0));
}
