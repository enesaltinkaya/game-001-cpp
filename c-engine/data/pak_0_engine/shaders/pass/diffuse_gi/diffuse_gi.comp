#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_ARB_shading_language_include : enable

#include "../../includes/utils.shader"
#include "../../includes/globalset.shader"

/* One 1D step of edge-aware colour diffusion (screen-space GI, Petersen
 * "Simplified Diffusion for Real-Time GI").
 *
 * Separable wide gaussian (17 taps, +-8) of the directly-lit scene colour,
 * one pass along X (dir=0) and one along Y (dir=1) per iteration, so the
 * directly-lit image bleeds across the screen until an edge stops it:
 *   - gaussian distance falloff,
 *   - relative inverse-depth edge (light does not cross occluders),
 *   - normal-dot edge (optional; OFF by default — the grass-colour-
 *     climbing-the-wall look IS the point of this pass).
 * The gaussian sigma is wide (tens of screen px) so colour travels a real
 * distance: grass green washes up the base of a wall, the wall's colour
 * washes onto the ground in front of it.
 *
 * Sky pixels are never diffused (copied verbatim) so the skybox stays crisp
 * and the horizon does not smear; sky taps contribute nothing.
 *
 * The pass runs at a fraction of render resolution (low-frequency data, the
 * composite upsamples linearly).  The composite then blends
 * (diffused - direct) * strength into the scene — sign-preserving, so the
 * bleed can darken/tint bright surfaces (green grass onto a white wall) as
 * well as brighten dark ones (light leak into shadows). */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint srcIndex;       /* directly-lit colour input (sampled)  */
    uint depthIndex;     /* depth buffer (sampled, sky = 0)      */
    uint normalsIndex;  /* oct-encoded normals (sampled)        */
    uint outIndex;       /* diffused output (storage)            */
    uint width;          /* output (GI buffer) width             */
    uint height;         /* output (GI buffer) height            */
    uint dir;            /* 0 = horizontal, 1 = vertical         */
    float sigma;         /* gaussian sigma, GI-buffer px         */
    float depthEdge;     /* relative inv-depth diff -> weight 0  */
    float normalEdgeMin; /* nDot window start; <= -1 disables    */
    float normalEdgeMax; /* nDot window end                      */
} pc;

const int TAP = 8;  /* +-8 taps, 17 total */

/* Inverse view-space depth S (affine in the raw buffer value); relative
 * differences in S equal relative differences in true view distance.
 * Same convention as ao_temporal.comp. */
float depthToInv(float rawDepth) {
    if (rawDepth <= 0.0) return 0.0;
    float N = sceneBuffer.cameras[0].zNear;
    float F = sceneBuffer.cameras[0].zFar;
    return (N + (F - N) * rawDepth) / (N * F);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) return;

    vec2 outRes = vec2(pc.width, pc.height);
    /* Both the GI buffer and the full-res source buffers cover the same
     * screen, so a +-1 output-pixel offset is the same UV offset in both:
     * the linear sampler averages the source pixels under each GI pixel. */
    vec2 centerUv = (vec2(coord) + 0.5) / outRes;

    float centerDepth = texture(
        sampler2D(textures[nonuniformEXT(pc.depthIndex)], samplers[SAMPLER_NEAREST]),
        centerUv).r;

    if (centerDepth <= 0.0) {
        /* Sky: copy verbatim (no diffusion, no horizon smear). */
        imageStore(storageImages[nonuniformEXT(pc.outIndex)], coord, texture(
            sampler2D(textures[nonuniformEXT(pc.srcIndex)], samplers[SAMPLER_CLAMP_LINEAR]),
            centerUv));
        return;
    }

    vec3 centerColor = texture(
        sampler2D(textures[nonuniformEXT(pc.srcIndex)], samplers[SAMPLER_CLAMP_NEAREST]),
        centerUv).rgb;
    vec3 centerN = OctDecode(texture(
        sampler2D(textures[nonuniformEXT(pc.normalsIndex)], samplers[SAMPLER_NEAREST]),
        centerUv).rg);
    float s0 = depthToInv(centerDepth);

    ivec2 axis = pc.dir == 0 ? ivec2(1, 0) : ivec2(0, 1);

    vec3 acc  = centerColor;
    float wSum = 1.0;
    float inv2S2 = 1.0 / (2.0 * pc.sigma * pc.sigma);

    for (int i = -TAP; i <= TAP; i++) {
        if (i == 0) continue;

        vec2 tapUv = centerUv + vec2(axis) * float(i) / outRes;

        float tapDepth = texture(
            sampler2D(textures[nonuniformEXT(pc.depthIndex)], samplers[SAMPLER_NEAREST]),
            tapUv).r;
        if (tapDepth <= 0.0) continue;  /* sky tap: no bleed */

        float dRel = abs(s0 - depthToInv(tapDepth)) / max(s0, 1e-6);
        float depthW = 1.0 - smoothstep(0.0, pc.depthEdge, dRel);
        if (depthW <= 0.0) continue;    /* occluded: no fetch left */

        float w = exp(float(i * i) * inv2S2) * depthW;

        if (pc.normalEdgeMin > -0.99) {
            vec3 tapN = OctDecode(texture(
                sampler2D(textures[nonuniformEXT(pc.normalsIndex)], samplers[SAMPLER_NEAREST]),
                tapUv).rg);
            w *= smoothstep(pc.normalEdgeMin, pc.normalEdgeMax, dot(centerN, tapN));
        }

        if (w <= 0.0) continue;

        acc  += w * texture(
            sampler2D(textures[nonuniformEXT(pc.srcIndex)], samplers[SAMPLER_CLAMP_NEAREST]),
            tapUv).rgb;
        wSum += w;
    }

    imageStore(storageImages[nonuniformEXT(pc.outIndex)], coord, vec4(acc / wSum, 1.0));
}
