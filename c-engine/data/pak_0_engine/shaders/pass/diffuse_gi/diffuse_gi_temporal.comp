#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_ARB_shading_language_include : enable

#include "../../includes/utils.shader"
#include "../../includes/globalset.shader"

/* Temporal filter for the diffusion GI field.
 *
 * The spatial diffusion is a fresh screen-aligned blur every frame: as the
 * camera moves, the fixed low-res tap grid re-aligns against the scene and
 * the blurred field wiggles frame-to-frame.  Feeding that into TAA makes
 * the reprojected history disagree with the current frame, TAA's
 * neighbourhood rejections fire unevenly on high-frequency surfaces (grass)
 * and the result shimmers.
 *
 * Fix (the standard screen-space-GI temporal filter): reproject last
 * frame's GI field with the same motion vectors TAA uses and blend it
 * into this frame's spatial result, so the field handed to the composite
 * is reprojection-consistent.  The history buffer carries this frame's
 * inverse-view-depth S in its alpha (0 = "no data": right after a clear, a
 * resize, or a sky pixel — must be rejected, same convention as taa.comp).
 *
 * The rejections below mirror taa.comp's cutout-edge-aware machinery: the
 * raw field is a low-frequency blur, but it is still evaluated per-pixel
 * against alpha-tested grass where depth flips between blade and gap
 * under jitter.  A naive "depthDiff is large -> reject" test fires
 * randomly at those edges and the history weight flickers — the original
 * grass shimmer.  Both rejections therefore measure the history against
 * the current NEIGHBOURHOOD (3x3 span) instead of against the pixel, and
 * the history is clamped into the neighbourhood AABB before the blend.
 * The motion-confidence falloff is a wide safety net (64->512 px) for
 * extreme camera whips: the field is low-frequency at 1/4 resolution and
 * the rejections above already handle content change, so motion magnitude
 * alone must not gate the history — while running, full-res MVs routinely
 * exceed 30 px and a tight curve would throw the history away exactly when
 * the temporal filter is needed (the grass shimmer case). */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint spatialIndex;    /* this frame's diffused result (sampled)    */
    uint historyIndex;    /* previous frame's history (sampleed)       */
    uint velocityIndex;   /* motion vectors (sampled, render-res px)  */
    uint depthIndex;      /* depth buffer (sampled, sky = 0)          */
    uint outIndex;        /* new history (storage)                    */
    uint width;           /* GI buffer width */
    uint height;          /* GI buffer height */
    uint fullWidth;       /* velocity buffer dimensions */
    uint fullHeight;
    float temporalWeight; /* max history blend (0..1)                 */
    float depthThreshold; /* relative S-space temporal depth rejection */
    float colorThreshold; /* relative colour rejection threshold      */
} pc;

float depthToInv(float rawDepth) {
    if (rawDepth <= 0.0) return 0.0;
    float N = sceneBuffer.cameras[0].zNear;
    float F = sceneBuffer.cameras[0].zFar;
    return (N + (F - N) * rawDepth) / (N * F);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) return;

    vec2 res     = vec2(pc.width, pc.height);
    vec2 fullRes = vec2(pc.fullWidth, pc.fullHeight);
    vec2 scale   = fullRes / res;

    /* Pixel-center-accurate remap: GI texel `coord` covers the full-res
     * block [coord*scale, coord*scale + scale), so the full-res depth /
     * velocity sample for it sits at that block's center.  The inverse
     * maps reprojected full-res pixel positions back to GI-buffer uv. */
    vec2 fullPx = vec2(coord) * scale;
    vec2 fullUv = (fullPx + 0.5) / fullRes;
    vec2 uv     = (vec2(coord) + 0.5) / res;

    vec3 curr = texture(
        sampler2D(textures[nonuniformEXT(pc.spatialIndex)], samplers[SAMPLER_CLAMP_LINEAR]),
        uv).rgb;

    float s0 = depthToInv(texture(
        sampler2D(textures[nonuniformEXT(pc.depthIndex)], samplers[SAMPLER_NEAREST]),
        fullUv).r);

    if (s0 <= 0.0) {
        /* Sky: carry the value, no history (alpha 0 = "no data"). */
        imageStore(storageImages[nonuniformEXT(pc.outIndex)], coord, vec4(curr, 0.0));
        return;
    }

    vec2 mv = texture(
        sampler2D(textures[nonuniformEXT(pc.velocityIndex)], samplers[SAMPLER_NEAREST]),
        fullUv).xy;
    vec2 reprojPx = fullPx - mv;
    bool prevValid = reprojPx.x >= 0.0 && reprojPx.x < fullRes.x &&
                     reprojPx.y >= 0.0 && reprojPx.y < fullRes.y;

    /* ── 3x3 neighbourhood (GI resolution) ─────────────────────────────
     * Colour range and full-res depth S span of the current field, the
     * same cutout-edge machinery as taa.comp: a cutout edge flips the
     * per-pixel depth between the blade and what's behind it from frame
     * to frame, but that flip stays INSIDE the neighbourhood span, so
     * the excess-based rejections below do not fire on it.  A true
     * disocclusion brings a surface in whose depth / colour lies outside
     * the neighbourhood — that is what the rejections catch. */
    vec3   nMin  = curr;
    vec3   nMax  = curr;
    float  nSMin = s0;
    float  nSMax = s0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            vec2 gCoord = vec2(coord) + vec2(dx, dy);
            if (gCoord.x < 0.0 || gCoord.x >= res.x ||
                gCoord.y < 0.0 || gCoord.y >= res.y) continue;
            vec3 c = texture(
                sampler2D(textures[nonuniformEXT(pc.spatialIndex)], samplers[SAMPLER_CLAMP_LINEAR]),
                (gCoord + 0.5) / res).rgb;
            nMin = min(nMin, c);
            nMax = max(nMax, c);
            vec2 nUv = (gCoord * scale + 0.5) / fullRes;
            float sn = depthToInv(texture(
                sampler2D(textures[nonuniformEXT(pc.depthIndex)], samplers[SAMPLER_NEAREST]),
                nUv).r);
            nSMin = min(nSMin, sn);
            nSMax = max(nSMax, sn);
        }
    }

    vec3  nRange = nMax - nMin;
    /* Pad the AABB like taa.comp so flat-area bounds do not oscillate
     * under the sub-pixel jitter shift. */
    vec3  nPad   = max(nRange * 0.5, vec3(0.005));
    vec3  aabbMin = nMin - nPad;
    vec3  aabbMax = nMax + nPad;

    float weight = 0.0;
    if (prevValid) {
        /* reprojPx is in full-res pixel units (fullPx - mv); the history UV
         * is reprojPx / fullRes in [0,1].  (The old (res/fullRes) factor
         * scaled to GI-buffer pixel units [0,res), clamping to the corner
         * texel — the temporal filter never read last frame's field.) */
        vec4 prev = texture(
            sampler2D(textures[nonuniformEXT(pc.historyIndex)], samplers[SAMPLER_CLAMP_LINEAR]),
            reprojPx / fullRes);
        float prevS = max(prev.a, 0.0);
        if (prevS > 1e-5) {
            /* Temporal depth rejection: relative S difference beyond the
             * neighbourhood's own span (cutout-edge aware, like taa.comp). */
            float sMaxV     = max(s0, prevS);
            float depthDiff  = abs(s0 - prevS) / sMaxV;
            float spanRel   = (nSMax - nSMin) / max(nSMax, 1e-5);
            float depthExcess = max(depthDiff - spanRel, 0.0);
            float depthReject = smoothstep(pc.depthThreshold * 0.25,
                                            pc.depthThreshold, depthExcess);

            /* Colour rejection: history deviating from the neighbourhood
             * colour range beyond the local span -> content change. */
            vec3  prevDev      = max(aabbMin - prev.rgb, prev.rgb - aabbMax);
            float prevDevMax   = max(prevDev.x, max(prevDev.y, prevDev.z));
            float nSpanC       = max(nRange.x, max(nRange.y, nRange.z));
            float colorOutFrac = prevDevMax / (nSpanC + 1e-4);
            float colorReject  = smoothstep(pc.colorThreshold * 0.5,
                                            pc.colorThreshold, colorOutFrac);

            /* Motion-confidence falloff: the field is low-frequency at 1/4
             * resolution, so reprojected history stays coherent far beyond
             * the per-frame camera delta.  The tight 2->8 px curve used to
             * zero the history for ~92% of the screen while running (median
             * |mv| ~ 40 px), disabling the temporal filter exactly in the
             * grass-shimmer case.  Content change is covered by the
             * neighbourhood depth/colour rejections above, so the magnitude
             * falloff is only a safety net for extreme camera whips. */
            float motionConf = 1.0 - smoothstep(64.0, 512.0, length(mv));

            weight  = pc.temporalWeight * motionConf * (1.0 - max(depthReject, colorReject));
            curr    = mix(curr, clamp(prev.rgb, aabbMin, aabbMax), weight);
        }
    }

    imageStore(storageImages[nonuniformEXT(pc.outIndex)], coord, vec4(curr, s0));
}
