#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_ARB_shading_language_include : enable

// Screen-space GI estimate (plans/ssgi.md D3, Phase 1b) — hemisphere ray
// march against the depth buffer.
//
// Per half-res texel: cosine-weighted hemisphere rays around the surface
// normal march in world space using the ssr.comp screen-projection
// conventions (unjittered VP projection, unjittered->jittered depth
// sampling, reversed-Z behind test + thickness window).  Hit radiance is
// reconstructed ANALYTICALLY — never sampled from the lit scene color
// buffer, which contains the previous frame's GI (unbounded feedback, see
// ledger notes) — as the hit surface's diffuse outgoing radiance:
//
//     L_hit = hitAlbedo/PI * (1 - hitMetallic) * (sunColor*NdotL + E_sky)
//
// and accumulated in *irradiance* units (x PI per ray, cosine-weighted MC:
// E = PI * mean(L_i)), so a fully-missed texel equals skyIrradiance(N) and
// the consumer-side mix against the IBL ambient is an identity on open sky
// (units contract, ledger notes lemma 1).  Hit rays are additionally gated
// for plausibility (backface/self-hit, grazing, opposing-parallel
// "sandwich" surfaces, thin-silhouette hit neighbourhood) — gated rays
// revert to the texel's own IBL sky irradiance skyIrradiance(N) (NOT the
// ray-direction value: the mean over a gated ray-direction subset is
// Jensen-biased against E(N), the same second-order hue error the cyan
// cast exhibits) and shed confidence (ssgi-artifacts Phase 1).
// rgb = irradiance estimate,
// a = confidence (origin depth-edge fade x per-ray depth-agreement mean).
//
// Per-ray miss (and rays that leave the screen) fall back to the IBL sky
// irradiance for the ray direction — the same chain scene.frag mixes
// against.  Emissives and Forward+ lights contribute no GI (accepted).

#include "../../includes/utils.shader"
#include "../../includes/globalset.shader"
#include "../../includes/ibl_common.shader"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint depthIndex;   // full-res depth (sampled, reversed-Z)
    uint normalsIndex; // oct-encoded world normals (sampled)
    uint albedoIndex;  // base albedo (sampled, RGBA16F)
    uint materialIndex; // roughness/metallic/alphaMask (sampled)
    uint outputIndex;  // half-res estimate (storage)
    uint sourceWidth;  // full-res G-buffer size
    uint sourceHeight;
    uint outputWidth;  // half-res estimate size
    uint outputHeight;
    uint rayCount;     // hemisphere rays per texel (ENGINE_GI_RAYS, def. 6)
    float distScale;   // max-distance multiplier (ENGINE_GI_DIST_SCALE)
};

// March shape: short fixed-size near steps, then doubling growth
// (plans/ssgi.md D3).  The step count stays ~GI_MARCH_STEPS for any
// maxDist while as much world is searched near the receiver as far away.
#define GI_MARCH_STEPS 6
#define GI_REFINE_STEPS 2
#define GI_STEP_GROWTH 2.0

// ---------------------------------------------------------------------------
// IBL sampling — identical chain and constants to scene.frag (the 8th copy
// per project convention; envRotation keeps the estimate in sync with the
// rotated extracted sun).
// ---------------------------------------------------------------------------
vec3 sampleEnvironment(vec3 dir, float lod) {
    dir = mat3(sceneBuffer.ibl.envRotation) * dir;
    return textureLod(sampler2D(textures[nonuniformEXT(sceneBuffer.ibl.environmentMapIndex)],
                                samplers[SAMPLER_LINEAR]),
                      directionToEquirectUv(dir),
                      clamp(lod, 0.0, sceneBuffer.ibl.environmentMapMaxLod))
        .rgb;
}

vec3 sampleIrradiance(vec3 dir) {
    dir = mat3(sceneBuffer.ibl.envRotation) * dir;
    return min(texture(samplerCube(cubeTextures[nonuniformEXT(sceneBuffer.ibl.irradianceMapIndex)],
                                   samplers[SAMPLER_LINEAR]),
                       normalize(dir))
                   .rgb,
               vec3(32.0));
}

vec3 evaluateSHIrradiance(vec3 N) {
    vec3 rN         = mat3(sceneBuffer.ibl.envRotation) * N;
    const float A0  = PI;
    const float A1  = 2.0 * PI / 3.0;
    const float Y00 = 0.282095;
    const float Y1x = 0.488603;
    vec3 irr        = vec3(0.0);
    irr += sceneBuffer.ibl.shL0_M0.rgb * A0 * Y00;
    irr += sceneBuffer.ibl.shL1_Mp1.rgb * A1 * Y1x * rN.x;
    irr += sceneBuffer.ibl.shL1_Mn1.rgb * A1 * Y1x * rN.y;
    irr += sceneBuffer.ibl.shL1_M0.rgb * A1 * Y1x * rN.z;
    return max(irr, vec3(0.0));
}

// Radiance folded to diffuse irradiance — the same fallback chain and
// order as scene.frag's ambient block.
vec3 skyIrradiance(vec3 N) {
    if (sceneBuffer.ibl.irradianceMapIndex != 0u)
        return sampleIrradiance(N);
    else if (sceneBuffer.ibl.hasSH != 0u)
        return evaluateSHIrradiance(N);
    else
        return sampleEnvironment(N, sceneBuffer.ibl.environmentMapMaxLod);
}

// ---------------------------------------------------------------------------
// G-buffer fetches (full-res; the depth/normals G-buffer was rasterised
// with the jittered projection, so coordinate-driven fetches are exact).
// ---------------------------------------------------------------------------
float fetchDepth(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(sourceWidth) - 1, int(sourceHeight) - 1));
    return texelFetch(sampler2D(textures[nonuniformEXT(depthIndex)],
                                samplers[SAMPLER_CLAMP_NEAREST]),
                      coord, 0).r;
}

vec3 fetchNormal(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(sourceWidth) - 1, int(sourceHeight) - 1));
    vec2 enc = texelFetch(sampler2D(textures[nonuniformEXT(normalsIndex)],
                                    samplers[SAMPLER_CLAMP_NEAREST]),
                          coord, 0).rg;
    return normalize(OctDecode(enc));
}

vec3 fetchAlbedo(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(sourceWidth) - 1, int(sourceHeight) - 1));
    return texelFetch(sampler2D(textures[nonuniformEXT(albedoIndex)],
                                samplers[SAMPLER_CLAMP_NEAREST]),
                      coord, 0).rgb;
}

// (roughness, metallic, alphaMask)
vec3 fetchMaterial(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(sourceWidth) - 1, int(sourceHeight) - 1));
    return texelFetch(sampler2D(textures[nonuniformEXT(materialIndex)],
                                samplers[SAMPLER_CLAMP_NEAREST]),
                      coord, 0).rgb;
}

// ---------------------------------------------------------------------------
// Screen projection — ssr.comp conventions (unjittered VP for stability,
// jittered-UV conversion for G-buffer sampling).
// ---------------------------------------------------------------------------
vec3 projectToScreen(vec3 worldPos) {
    vec4 clip = sceneBuffer.cameras[0].viewProjectionNoJitter * vec4(worldPos, 1.0);
    if (clip.w <= 0.0) return vec3(-1.0);
    vec3 ndc = clip.xyz / clip.w;
    vec2 uv  = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    return vec3(uv, ndc.z);
}

float sampleDepthUnjittered(vec2 uv) {
    vec2 jitteredUv = clamp(uv - vec2(sceneBuffer.cameras[0].jitterX,
                                      sceneBuffer.cameras[0].jitterY),
                            vec2(0.0), vec2(1.0));
    ivec2 icoord = ivec2(jitteredUv * vec2(sourceWidth, sourceHeight));
    icoord = clamp(icoord, ivec2(0), ivec2(int(sourceWidth) - 1, int(sourceHeight) - 1));
    return texelFetch(sampler2D(textures[nonuniformEXT(depthIndex)],
                                samplers[SAMPLER_CLAMP_NEAREST]),
                      icoord, 0).r;
}

// World position of a full-res G-buffer texel (unjittered inverse VP with
// the texel's depth — ssr.comp world reconstruction).
vec3 reconstructWorldPos(ivec2 coord, float depth) {
    vec2 unjitteredUv = (vec2(coord) + 0.5) / vec2(sourceWidth, sourceHeight)
                        + vec2(sceneBuffer.cameras[0].jitterX,
                               sceneBuffer.cameras[0].jitterY);
    vec2 ndc    = vec2(unjitteredUv.x * 2.0 - 1.0, 1.0 - unjitteredUv.y * 2.0);
    vec4 worldH = sceneBuffer.cameras[0].invViewProjectionNoJitter * vec4(ndc, depth, 1.0);
    return worldH.xyz / worldH.w;
}

// ---------------------------------------------------------------------------
// Ray generation — cosine-weighted hemisphere around N (Malley's method)
// seeded by a per-texel/per-ray/per-frame hash.  No blue-noise LUT exists
// yet (sceneBuffer.blueNoiseIndex is unpopulated), so the deterministic
// hash fallback from the plan is used; the temporal filter (Phase 2)
// averages the per-frame noise into the estimate.
// ---------------------------------------------------------------------------
uint pcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float pcgRandom(inout uint seed) {
    seed = pcgHash(seed);
    return float(seed) / 4294967296.0;
}

vec3 cosineHemisphere(vec3 N, float u1, float u2) {
    float r   = sqrt(u1);
    float phi = 2.0 * PI * u2;
    vec3 up   = abs(N.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 t    = normalize(cross(up, N));
    vec3 b    = cross(N, t);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + N * sqrt(max(0.0, 1.0 - u1)));
}

// ---------------------------------------------------------------------------
// March — ssr.comp conventions: reversed-Z behind test (rayDepth <
// bufferDepth), thickness window growing with distance, binary refinement.
// Returns 0 = miss (reached maxDist), 1 = geometry hit, 2 = left screen.
// ---------------------------------------------------------------------------
int traceRay(vec3 startPos, vec3 dir, float maxDist,
             out float hitT, out vec2 hitUv) {
    hitT = 0.0;
    hitUv = vec2(0.0);
    float t      = 0.0;
    float prevT  = 0.0;
    float step   = 0.02 + maxDist * 0.02;
    bool wasInFront = true;

    for (int i = 0; i < GI_MARCH_STEPS; i++) {
        prevT = t;
        t    += step;
        step *= GI_STEP_GROWTH;
        bool lastStep = false;
        if (t > maxDist) {
            t        = maxDist;
            lastStep = true; // final probe at maxDist; later iterations
                             // would re-sample the same position
        }

        vec3 sampleScreen = projectToScreen(startPos + dir * t);
        if (sampleScreen.x < 0.0 || sampleScreen.x > 1.0 ||
            sampleScreen.y < 0.0 || sampleScreen.y > 1.0) {
            return 2;
        }

        float bufDepth = sampleDepthUnjittered(sampleScreen.xy);
        if (bufDepth == 0.0) {
            // Open sky along the ray — keep marching, distant geometry
            // may still occlude.
            wasInFront = true;
        } else {
            bool isBehind = sampleScreen.z < bufDepth;
            if (isBehind && wasInFront) {
                float thickness = bufDepth - sampleScreen.z;
                float maxThickness = mix(0.05, 0.20, clamp(t / maxDist, 0.0, 1.0));
                if (thickness < maxThickness) {
                    // Binary refinement between the last in-front sample and
                    // the crossing (2 iterations — the hit feeds an analytic
                    // radiance lookup, not a color fetch, so half-texel
                    // accuracy is plenty).
                    float lo = prevT;
                    float hi = t;
                    hitUv = sampleScreen.xy;
                    for (int j = 0; j < GI_REFINE_STEPS; j++) {
                        float mid      = (lo + hi) * 0.5;
                        vec3 midScreen = projectToScreen(startPos + dir * mid);
                        if (midScreen.x < 0.0 || midScreen.x > 1.0 ||
                            midScreen.y < 0.0 || midScreen.y > 1.0) {
                            break;
                        }
                        float midBuf = sampleDepthUnjittered(midScreen.xy);
                        if (midBuf == 0.0) {
                            hitUv = midScreen.xy;
                            hitT  = mid;
                            return 1; // refined onto a sky texel (silhouette)
                        }
                        if (midScreen.z < midBuf) {
                            hi    = mid;
                            hitUv = midScreen.xy;
                        } else {
                            lo = mid;
                        }
                    }
                    hitT = hi;
                    return 1;
                }
            }
            wasInFront = !isBehind;
        }
        if (lastStep) break;
    }
    return 0;
}

// Origin-side depth-edge fade (ssr.comp depthEdgeFade, single cross at
// radius 1): 0 at silhouettes, 1 in flat regions.  Distance-scaled
// reversed-Z thresholds as in SSR.
float originEdgeFade(ivec2 center) {
    float centerD = fetchDepth(center);
    if (centerD == 0.0) return 0.0;
    float maxDelta = 0.0;
    float minD     = centerD;
    float maxD     = centerD;
    int skyCount   = 0;
    for (int i = 0; i < 4; i++) {
        ivec2 off = (i == 0) ? ivec2(-1, 0) : (i == 1) ? ivec2(1, 0)
                     : (i == 2) ? ivec2(0, -1) : ivec2(0, 1);
        float d = fetchDepth(center + off);
        if (d == 0.0) {
            skyCount++;
            continue;
        }
        maxDelta = max(maxDelta, abs(centerD - d));
        minD     = min(minD, d);
        maxD     = max(maxD, d);
    }
    if (skyCount > 0) {
        // Sky neighbour = silhouette: soft fade so thin geometry keeps
        // partial confidence (SSR behaviour).
        return max(0.4, 1.0 - float(skyCount) * 0.12);
    }
    maxDelta = max(maxDelta, maxD - minD);
    float threshold = max(0.0006, centerD * 0.003);
    return 1.0 - smoothstep(threshold * 0.3, threshold, maxDelta);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(outputWidth) || coord.y >= int(outputHeight)) return;

    if (sceneBuffer.ibl.enabled == 0u) {
        // IBL off: scene.frag's ambient term is zero, so the estimate must
        // be zero too (consumers mix against that term).
        imageStore(storageImages[nonuniformEXT(outputIndex)], coord, vec4(0.0));
        return;
    }

    // ── Origin: closest texel of the 2x2 full-res block (reversed-Z max)
    // ────────────────────────────────────────────────────────────────────
    ivec2 base   = coord * 2;
    ivec2 origin = base;
    float originDepth = 0.0;
    for (int y = 0; y < 2; y++) {
        for (int x = 0; x < 2; x++) {
            ivec2 c  = clamp(base + ivec2(x, y), ivec2(0),
                             ivec2(int(sourceWidth) - 1, int(sourceHeight) - 1));
            float d  = fetchDepth(c);
            if (d > originDepth) {
                originDepth = d;
                origin      = c;
            }
        }
    }

    if (originDepth == 0.0) {
        // Sky texel: no surface to gather from.  Write the zenith miss
        // fallback at full confidence (P1a behaviour; consumers never
        // read ambient for sky pixels).
        imageStore(storageImages[nonuniformEXT(outputIndex)], coord,
                   vec4(skyIrradiance(vec3(0.0, 1.0, 0.0)), 1.0));
        return;
    }

    vec3 N       = fetchNormal(origin);
    vec3 worldPos = reconstructWorldPos(origin, originDepth);

    vec3 camPos   = sceneBuffer.cameras[0].position.xyz;
    float distToCam = length(worldPos - camPos);

    // Village-tuned defaults from the removed ao.comp (plans/ssgi.md D3):
    // short start offset along N (self-intersection), distance-scaled
    // reach, quadratic range fade on hits toward the miss fallback.
    float startDist = 0.005 + 0.01 * distToCam;
    float maxDist   = clamp(0.15 * distToCam, 1.0, 20.0) * distScale;
    vec3 startPos   = worldPos + N * startDist;

    vec3 sunDir  = normalize(-sceneBuffer.directionalLight.direction.xyz);
    vec3 sunColor = sceneBuffer.directionalLight.color.rgb
                    * sceneBuffer.directionalLight.direction.w;

    uint frameIndex = sceneBuffer.cameras[0].frameIndex;
    uint seed       = uint(coord.x) * 1973u + uint(coord.y) * 9277u
                      + frameIndex * 26699u;

    vec3 irradianceSum = vec3(0.0);
    float confidenceSum = 0.0;

    for (uint ray = 0u; ray < rayCount; ray++) {
        seed += 0x9E3779B9u * (ray + 1u);
        vec3 dir = cosineHemisphere(N, pcgRandom(seed), pcgRandom(seed));

        float hitT;
        vec2 hitUv;
        int kind = traceRay(startPos, dir, maxDist, hitT, hitUv);

        if (kind == 1) {
            // Geometry hit: analytic outgoing radiance of the hit surface
            // (shadowless direct + sky, both wrapped by its diffuse BRDF;
            // the hit's CACAO/shadow state is deliberately NOT applied —
            // the GI term replaces that occlusion).
            ivec2 hitCoord = ivec2(clamp(
                hitUv - vec2(sceneBuffer.cameras[0].jitterX,
                             sceneBuffer.cameras[0].jitterY),
                vec2(0.0), vec2(1.0)) * vec2(sourceWidth, sourceHeight));
            float hitDepth = fetchDepth(hitCoord);
            if (hitDepth == 0.0) {
                // Refined onto a sky texel (thin silhouette): miss.
                irradianceSum += skyIrradiance(dir);
                confidenceSum += 1.0;
                continue;
            }

            vec3 hitN = fetchNormal(hitCoord);

            // ── Hit reliability gates (ssgi-artifacts Phase 1) ──────────
            // A hit only counts as a bounce surface if it is plausible as
            // one; gated rays fall back to the miss (sky) radiance and
            // contribute proportionally less confidence, so the consumer
            // mix reverts to the IBL ambient there.
            //
            // (1) Backface / self-hit: the ray re-entered a closed surface
            // (or hit the far side of one) — a march artifact with no
            // trustworthy radiance.  (2) Grazing: near the hemisphere
            // rim the hit position is poorly resolved and the radiance
            // lookup unreliable — down-weight by frontness.  (3)
            // Opposing-parallel "sandwich": the hit surface faces back
            // at the origin surface (a character standing against the
            // wall: her front normal points at the wall the rays came
            // from).  Thin-gap inter-surface bounces are the classic
            // SSGI failure mode and are what darken the wall beside
            // her (the halo).  Hard-rejected below the threshold with
            // no gap ramp: a soft ramp spread the dark leak over a band
            // ~1.3 m wide (the 300-px halo), while the flat reject puts
            // the ring within ~2 % of the far-wall value (plans/
            // ssgi-halo.md Phase 1, verified 2026-09-01).  (4)
            // Thin silhouette: the hit texel's immediate neighbourhood
            // already shows sky or a different surface — the hit sits
            // on an edge with unknown radiance.
            //
            // Gated rays revert the estimate to the texel's OWN sky
            // irradiance skyIrradiance(N) — the exact IBL value
            // scene.frag mixes against — so an all-gated texel is
            // identical to the GI-OFF state.  The per-ray VALUE is
            // mixed by the gates SQUARED (w below): a partially gated
            // hit must revert to sky faster than its confidence falls,
            // or its (typically darker) radiance leaks 5–20 % into the
            // mean — the residual dip measured as the halo.  The
            // per-ray CONFIDENCE carries the linear gate, so the
            // consumer-side mix reverts to the IBL ambient as gating
            // increases.
            float front  = dot(hitN, -dir);
            float hitW   = (front > 0.0) ? smoothstep(0.05, 0.40, front) : 0.0;
            {
                // Sandwich hard reject: a hit normal opposing the origin
                // normal below -0.55 (≈122°) is a thin-gap bounce — full
                // rejection, no gap ramp (plans/ssgi-halo.md Phase 1).
                hitW *= step(-0.55, dot(N, hitN));
            }
            {
                if (hitW > 0.0) {
                    float neighMax = 0.0;
                    int   neighSky = 0;
                    for (int dy = -2; dy <= 2; dy++) {
                        for (int dx = -2; dx <= 2; dx++) {
                            if ((dx == 0 && dy == 0) ||
                                (abs(dx) + abs(dy) > 2))
                                continue;
                            float d = fetchDepth(hitCoord + ivec2(dx, dy));
                            if (d == 0.0) {
                                neighSky++;
                            } else {
                                neighMax = max(neighMax, abs(d - hitDepth));
                            }
                        }
                    }
                    // Wider cross catches hits a few px from a silhouette of
                    // foreshortened (oblique) thin geometry — the R-band of
                    // the halo is exactly that (her side, seen at an angle).
                    const ivec2 wide[4] = { ivec2(-3, 0), ivec2(3, 0),
                                            ivec2(0, -3), ivec2(0, 3) };
                    for (int i = 0; i < 4; i++) {
                        float d = fetchDepth(hitCoord + wide[i]);
                        if (d == 0.0) {
                            neighSky++;
                        } else {
                            neighMax = max(neighMax, abs(d - hitDepth));
                        }
                    }
                    float thinThresh = mix(0.0003, 0.003,
                                           clamp(hitT / maxDist, 0.0, 1.0));
                    float thin = max(float(neighSky > 0 ? 1 : 0), neighMax);
                    hitW *= 1.0 - smoothstep(thinThresh * 0.5, thinThresh, thin);
                }
            }

            if (hitW > 0.004) {
                vec3 hitAlbedo = fetchAlbedo(hitCoord);
                float hitMetallic = fetchMaterial(hitCoord).g;

                float NdotL  = max(dot(hitN, sunDir), 0.0);
                vec3 hitIrradiance = hitAlbedo * (1.0 - hitMetallic)
                                     * (sunColor * NdotL + skyIrradiance(hitN));

                // Range fade: hits approaching maxDist blend toward the
                // IBL fallback (continuous with a miss beyond maxDist).
                float rangeFade = 1.0 / (1.0 + (hitT / maxDist) * (hitT / maxDist));
                // Squared value weight: the hit term fades toward sky as
                // the square of the plausibility gates (see the block
                // doc above) — the partial-gate leak fix.
                float w         = rangeFade * hitW * hitW;
                irradianceSum += mix(skyIrradiance(N), hitIrradiance, w);

                // Depth-agreement confidence (SSR formula, scaled
                // threshold), scaled by the hit-reliability gates.
                vec3 refinedScreen = projectToScreen(startPos + dir * hitT);
                float depthDelta   = abs(hitDepth - refinedScreen.z);
                float depthThresh  = mix(0.0100, 0.0500,
                                         clamp(hitT / maxDist, 0.0, 1.0));
                confidenceSum += hitW * (1.0 - smoothstep(depthThresh * 0.5,
                                                          depthThresh,
                                                          depthDelta));
            } else {
                // Fully gated (backface / near-field sandwich / thin):
                // no scene information — the texel's own IBL sky (the
                // GI-OFF state) and no confidence.
                irradianceSum += skyIrradiance(N);
            }
        } else if (kind == 0) {
            // Miss: IBL sky for the ray direction, full confidence.
            irradianceSum += skyIrradiance(dir);
            confidenceSum += 1.0;
        } else {
            // Left the screen: no information — sky fallback at reduced
            // confidence (D3 step 5 screen-edge fade).
            irradianceSum += skyIrradiance(dir);
            confidenceSum += 0.5;
        }
    }

    vec3 estimate   = irradianceSum / float(rayCount);
    float confidence = originEdgeFade(origin) * (confidenceSum / float(rayCount));

    if (any(isnan(estimate)) || any(isinf(estimate))) estimate = vec3(0.0);
    estimate = clamp(estimate, vec3(0.0), vec3(65504.0));
    imageStore(storageImages[nonuniformEXT(outputIndex)], coord,
               vec4(estimate, confidence));
}
