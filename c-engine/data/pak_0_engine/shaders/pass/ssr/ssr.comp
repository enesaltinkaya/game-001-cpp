#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_ARB_shading_language_include : enable

// Screen-Space Reflections — coarse linear march + binary refinement.
// Outputs: RGBA16F — rgb = reflected color, a = confidence.

#include "../../includes/utils.shader"
#include "../../includes/globalset.shader"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint sceneColorIndex;
    uint depthIndex;
    uint hizIndex;
    uint normalsIndex;
    uint materialIndex;
    uint outputIndex;
    uint outputWidth;
    uint outputHeight;
    uint hizMipCount;
};

// Project world position to screen: returns (uv.xy, ndc.z)
// Uses the **unjittered** VP so that projected coordinates are stable
// across frames even when FSR jitter changes.  The returned UV is in
// unjittered screen space; callers that need to sample the (jittered)
// depth buffer must apply the jitter offset themselves.
vec3 projectToScreen(vec3 worldPos) {
    vec4 clip = sceneBuffer.cameras[0].viewProjectionNoJitter * vec4(worldPos, 1.0);
    if (clip.w <= 0.0) return vec3(-1.0);
    vec3 ndc = clip.xyz / clip.w;
    vec2 uv  = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    return vec3(uv, ndc.z);
}

// Convert an unjittered screen-space UV back to the current frame's
// jittered render target UV.  G-buffer inputs were rasterised with the
// jittered projection, so any lookup driven by an unjittered ray-march
// position must undo the unjitter transform before sampling.
vec2 jitteredUvFromUnjittered(vec2 uv) {
    return uv - vec2(sceneBuffer.cameras[0].jitterX,
                     sceneBuffer.cameras[0].jitterY);
}

// Sample the depth buffer at an *unjittered* screen-space UV.
// The ray marcher works in unjittered screen space for temporal
// stability, but the actual depth buffer is jittered.  Convert back to
// the current jittered UV before the deterministic texelFetch so that
// the same world-space point is queried each frame.
float sampleDepth(vec2 uv) {
    vec2 jitteredUv = clamp(jitteredUvFromUnjittered(uv), vec2(0.0), vec2(1.0));
    ivec2 icoord = ivec2(jitteredUv * vec2(outputWidth, outputHeight));
    icoord = clamp(icoord, ivec2(0), ivec2(int(outputWidth) - 1, int(outputHeight) - 1));
    return texelFetch(sampler2D(textures[nonuniformEXT(depthIndex)], samplers[SAMPLER_CLAMP_NEAREST]),
                      icoord, 0).r;
}

// Check whether a screen-space location sits on or near a depth edge.
// Returns 0 at sharp silhouettes, 1 in flat regions.
// `radius` controls the search distance in pixels.
float depthEdgeFade(vec2 centerUV, vec2 texelSize, int radius) {
    float centerD = sampleDepth(centerUV);

    // Sky pixel next to geometry — always an edge.
    if (centerD == 0.0) return 0.0;

    float maxDelta = 0.0;
    float minD     = centerD;
    float maxD     = centerD;

    // Sample a cross + diagonal pattern up to `radius` pixels out.
    for (int r = 1; r <= radius; r++) {
        float fr = float(r);
        float d0 = sampleDepth(centerUV + vec2(-fr * texelSize.x, 0.0));
        float d1 = sampleDepth(centerUV + vec2(fr * texelSize.x, 0.0));
        float d2 = sampleDepth(centerUV + vec2(0.0, -fr * texelSize.y));
        float d3 = sampleDepth(centerUV + vec2(0.0, fr * texelSize.y));

        // Sky neighbours indicate a silhouette — apply a soft fade
        // instead of hard kill so thin geometry (arms, grass) keeps
        // partial confidence.
        if (d0 == 0.0 || d1 == 0.0 || d2 == 0.0 || d3 == 0.0) {
            int skyCount = int(d0 == 0.0) + int(d1 == 0.0) + int(d2 == 0.0) + int(d3 == 0.0);
            return max(0.4, 1.0 - float(skyCount) * 0.12);
        }

        maxDelta = max(maxDelta, abs(centerD - d0));
        maxDelta = max(maxDelta, abs(centerD - d1));
        maxDelta = max(maxDelta, abs(centerD - d2));
        maxDelta = max(maxDelta, abs(centerD - d3));
        minD     = min(minD, min(min(d0, d1), min(d2, d3)));
        maxD     = max(maxD, max(max(d0, d1), max(d2, d3)));
    }

    // Also check the depth *range* across the neighbourhood.
    // Even if center matches one side, a large range means an edge is nearby.
    float rangeD = maxD - minD;
    maxDelta     = max(maxDelta, rangeD);

    float threshold = max(0.0006, centerD * 0.003);
    return 1.0 - smoothstep(threshold * 0.3, threshold, maxDelta);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(outputWidth) || coord.y >= int(outputHeight)) return;

    vec2 uv        = (vec2(coord) + 0.5) / vec2(outputWidth, outputHeight);
    vec2 texelSize = 1.0 / vec2(outputWidth, outputHeight);

    // Jitter offset in UV space — used only for world-position reconstruction
    // of the origin pixel and for scene-color sampling at the hit point.
    vec2 jitterOffset = vec2(sceneBuffer.cameras[0].jitterX,
                             sceneBuffer.cameras[0].jitterY);

    // ── Sample depth ─────────────────────────────────────────────────────
    // `uv` is the raw pixel-center UV; the depth/normal/material buffers
    // are sampled directly at `uv` (no jitter correction needed — these
    // are per-pixel stores that match coord).
    float depth = texelFetch(
        sampler2D(textures[nonuniformEXT(depthIndex)], samplers[SAMPLER_CLAMP_NEAREST]),
        coord, 0).r;
    if (depth == 0.0) {
        imageStore(storageImages[nonuniformEXT(outputIndex)], coord, vec4(0.0));
        return;
    }

    // ── Sample roughness ─────────────────────────────────────────────────
    float roughness =
        texture(sampler2D(textures[nonuniformEXT(materialIndex)], samplers[SAMPLER_CLAMP_NEAREST]),
                uv)
            .r;

    if (roughness > 0.25) {
        imageStore(storageImages[nonuniformEXT(outputIndex)], coord, vec4(0.0));
        return;
    }

    // ── World normal ─────────────────────────────────────────────────────
    vec2 normEnc =
        texture(sampler2D(textures[nonuniformEXT(normalsIndex)], samplers[SAMPLER_CLAMP_NEAREST]),
                uv)
            .rg;
    vec3 N = OctDecode(normEnc);

    // ── Reconstruct world position ───────────────────────────────────────
    // Unjitter the pixel UV, then use the unjittered inverse VP to get a
    // stable world position that doesn't shift with per-frame jitter.
    vec2 unjitteredUv = uv + jitterOffset;
    vec2 ndc          = vec2(unjitteredUv.x * 2.0 - 1.0, 1.0 - unjitteredUv.y * 2.0);
    vec4 worldH       = sceneBuffer.cameras[0].invViewProjectionNoJitter * vec4(ndc, depth, 1.0);
    vec3 worldPos     = worldH.xyz / worldH.w;

    // ── Reflection direction (world space) ───────────────────────────────
    vec3 camPos = sceneBuffer.cameras[0].position.xyz;
    vec3 V      = normalize(camPos - worldPos);
    vec3 R      = reflect(-V, N);

    // Skip reflections pointing strongly into the ground
    if (R.y < -0.8) {
        imageStore(storageImages[nonuniformEXT(outputIndex)], coord, vec4(0.0));
        return;
    }

    // ── Coarse linear march ──────────────────────────────────────────────
    float distToCam = length(worldPos - camPos);
    float maxDist   = clamp(distToCam * 5.0, 40.0, 1000.0);

    // Offset start to avoid self-intersection.
    vec3 startPos = worldPos + N * 0.01 + R * 0.01;

    const float MIN_TRACE_T     = 0.01;
    const float NEAR_TRACE_DIST = 10.0;
    const int NEAR_STEPS        = 128;
    const int COARSE_STEPS      = 96;
    float t                     = 0.0;

    vec3 prevWorld  = startPos;
    vec3 prevScreen = projectToScreen(prevWorld);
    bool wasInFront = true;

    int hitStep = -1;
    float hitT  = 0.0;
    float prevT = 0.0;
    bool skyHit = false;
    vec2 hitUV  = vec2(0.0);

    // Near-field linear march.
    for (int i = 0; i < NEAR_STEPS; i++) {
        float frac = float(i + 1) / float(NEAR_STEPS);
        t          = max(MIN_TRACE_T, NEAR_TRACE_DIST * frac);

        vec3 sampleWorld  = startPos + R * t;
        vec3 sampleScreen = projectToScreen(sampleWorld);

        if (sampleScreen.x < 0.0) {
            break;
        }

        float bufDepth = sampleDepth(sampleScreen.xy);
        if (bufDepth == 0.0) {
            skyHit  = true;
            hitUV   = sampleScreen.xy;
            hitT    = t;
            hitStep = i;
            break;
        }

        float rayDepth = sampleScreen.z;
        bool isBehind  = rayDepth < bufDepth;

        if (isBehind && wasInFront) {
            float thickness = bufDepth - rayDepth;
            if (thickness >= 0.0 && thickness < 0.20) {
                hitStep = i;
                hitT    = t;
                hitUV   = sampleScreen.xy;
                break;
            }
        }

        wasInFront = !isBehind;
        prevT      = t;
        prevWorld  = sampleWorld;
        prevScreen = sampleScreen;
    }

    // Coarse quadratic march.
    if (hitStep < 0) {
        for (int i = 0; i < COARSE_STEPS; i++) {
            float frac = float(i + 1) / float(COARSE_STEPS);
            t          = mix(NEAR_TRACE_DIST, maxDist, frac * frac);

            vec3 sampleWorld  = startPos + R * t;
            vec3 sampleScreen = projectToScreen(sampleWorld);

            if (sampleScreen.x < 0.0) {
                break;
            }

            float bufDepth = sampleDepth(sampleScreen.xy);

            if (bufDepth == 0.0) {
                skyHit  = true;
                hitUV   = sampleScreen.xy;
                hitT    = t;
                hitStep = NEAR_STEPS + i;
                break;
            }

            float rayDepth = sampleScreen.z;
            bool isBehind  = rayDepth < bufDepth;

            if (isBehind && wasInFront) {
                float thickness    = bufDepth - rayDepth;
                float distScale    = t / maxDist;
                float maxThickness = mix(0.10, 0.25, distScale);

                if (thickness >= 0.0 && thickness < maxThickness) {
                    hitStep = NEAR_STEPS + i;
                    hitT    = t;
                    hitUV   = sampleScreen.xy;
                    break;
                }
            }

            wasInFront = !isBehind;
            prevT      = t;
            prevWorld  = sampleWorld;
            prevScreen = sampleScreen;
        }
    }

    if (hitStep < 0) {
        imageStore(storageImages[nonuniformEXT(outputIndex)], coord, vec4(0.0));
        return;
    }

    // ── Binary refinement (skip for sky hits) ────────────────────────────
    if (!skyHit) {
        float lo = prevT;
        float hi = hitT;
        for (int j = 0; j < 8; j++) {
            float mid      = (lo + hi) * 0.5;
            vec3 midWorld  = startPos + R * mid;
            vec3 midScreen = projectToScreen(midWorld);

            if (midScreen.x < 0.0) break;

            float midBufDepth = sampleDepth(midScreen.xy);
            if (midBufDepth == 0.0) {
                skyHit = true;
                hitUV  = midScreen.xy;
                break;
            }

            float midRayDepth = midScreen.z;
            if (midRayDepth < midBufDepth) {
                hi    = mid;
                hitUV = midScreen.xy;
            } else {
                lo = mid;
            }
        }
        // Update hitT to the refined value so depth-agreement uses
        // the correct position.
        hitT = hi;
    }

    // ── Sample reflected color ───────────────────────────────────────────
    // hitUV is in unjittered screen space, but SceneColor was rendered
    // with the jittered projection. Convert back to the jittered UV so
    // the reflected texel follows the same world-space point each frame.
    vec2 hitSampleUv = clamp(jitteredUvFromUnjittered(hitUV), vec2(0.0), vec2(1.0));
    ivec2 hitCoord = ivec2(hitSampleUv * vec2(outputWidth, outputHeight));
    hitCoord = clamp(hitCoord, ivec2(0), ivec2(int(outputWidth) - 1, int(outputHeight) - 1));
    vec3 hitColor = texelFetch(
        sampler2D(textures[nonuniformEXT(sceneColorIndex)], samplers[SAMPLER_CLAMP_LINEAR]),
        hitCoord, 0).rgb;

    // ── Confidence ───────────────────────────────────────────────────────
    vec2 edgeDist    = min(hitUV, 1.0 - hitUV);
    float edgeFade   = smoothstep(0.0, 0.02, min(edgeDist.x, edgeDist.y));
    float roughFade  = 1.0 - smoothstep(0.05, 0.25, roughness);
    float skyPenalty = skyHit ? 0.85 : 1.0;

    // ── Depth-agreement fade ─────────────────────────────────────────────
    // Reject hits whose refined ray depth disagrees with the depth buffer.
    // Catches false intersections that produce thin line artefacts.
    float depthAgreeFade = 1.0;
    if (!skyHit) {
        vec3 refinedWorld  = startPos + R * hitT;
        vec3 refinedScreen = projectToScreen(refinedWorld);
        float hitDepth     = sampleDepth(hitUV);
        float depthDelta   = abs(hitDepth - refinedScreen.z);
        float depthThresh  = mix(0.0100, 0.0500, clamp(hitT / maxDist, 0.0, 1.0));
        depthAgreeFade     = 1.0 - smoothstep(depthThresh * 0.5, depthThresh, depthDelta);
    }

    // ── Silhouette halo suppression (hit side) ───────────────────────────
    float hitEdgeFade = depthEdgeFade(hitUV, texelSize, 1);

    // ── Origin-side edge suppression ─────────────────────────────────────
    // If the reflecting puddle pixel is itself near a depth discontinuity
    // (e.g. right next to the character's feet), its reflection ray is very
    // likely to produce a halo. Fade SSR at those pixels.
    float originEdgeFade = depthEdgeFade(unjitteredUv, texelSize, 0);

    float confidence =
        edgeFade * roughFade * skyPenalty * depthAgreeFade * hitEdgeFade * originEdgeFade;

    imageStore(storageImages[nonuniformEXT(outputIndex)], coord, vec4(hitColor, confidence));
}
