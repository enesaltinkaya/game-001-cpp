#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_ARB_shading_language_include : enable

// SSGI — temporal accumulation with variance clipping.
// Port of contact_shadow_temporal.comp: the single scalar value becomes
// RGBA (rgb = bounce irradiance, a = confidence); variance clipping is
// per-channel over rgb, alpha rides the same blend factor.

#include "../../includes/utils.shader"
#include "../../includes/globalset.shader"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint  currentIndex;
    uint  historyIndex;
    uint  velocityIndex;
    uint  depthIndex;
    uint  normalIndex;
    uint  outputIndex;
    uint  width;
    uint  height;
    uint  historyValid;
    float jitterDeltaX;
    float jitterDeltaY;
} pc;

float linearizeDepth(float d) {
    float N = sceneBuffer.cameras[0].zNear;
    float F = sceneBuffer.cameras[0].zFar;
    return (N * F) / max(N + (F - N) * d, 1e-7);
}

vec3 loadNormal(ivec2 coord) {
    return normalize(texelFetch(sampler2D(textures[nonuniformEXT(pc.normalIndex)],
                                          samplers[SAMPLER_NEAREST]),
                                coord, 0).rgb);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) return;

    vec4 current = texelFetch(sampler2D(textures[nonuniformEXT(pc.currentIndex)],
                                        samplers[SAMPLER_NEAREST]),
                              coord, 0);

    float centerDepth = texelFetch(sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                                             samplers[SAMPLER_NEAREST]),
                                   coord, 0).r;
    if (centerDepth == 0.0 || pc.historyValid == 0u) {
        imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord, current);
        return;
    }

    vec3  centerNormal = loadNormal(coord);
    float centerLinZ   = linearizeDepth(centerDepth);

    /* Closest-depth velocity dilation (3×3). */
    float bestDepth = 0.0;
    ivec2 bestOff   = ivec2(0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 sc = clamp(coord + ivec2(x, y),
                             ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
            float d = texelFetch(sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                                           samplers[SAMPLER_NEAREST]),
                                 sc, 0).r;
            if (d > bestDepth) {
                bestDepth = d;
                bestOff   = ivec2(x, y);
            }
        }
    }

    ivec2 velCoord = clamp(coord + bestOff,
                           ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
    vec2 velocity = texelFetch(sampler2D(textures[nonuniformEXT(pc.velocityIndex)],
                                         samplers[SAMPLER_NEAREST]),
                               velCoord, 0).rg;

    vec2 size = vec2(pc.width, pc.height);
    vec2 uv   = (vec2(coord) + 0.5) / size;
    vec2 historyUV = uv - velocity / size +
                     vec2(pc.jitterDeltaX, pc.jitterDeltaY);

    if (historyUV.x < 0.0 || historyUV.x > 1.0 || historyUV.y < 0.0 || historyUV.y > 1.0) {
        imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord, current);
        return;
    }

    ivec2 historyCoord = clamp(ivec2(historyUV * size),
                               ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));

    float historyDepth = texelFetch(sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                                              samplers[SAMPLER_NEAREST]),
                                    historyCoord, 0).r;
    if (historyDepth == 0.0) {
        imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord, current);
        return;
    }

    vec3  historyNormal = loadNormal(historyCoord);
    float historyLinZ   = linearizeDepth(historyDepth);
    float relDepthDiff  = abs(centerLinZ - historyLinZ) / max(max(centerLinZ, historyLinZ), 1e-4);
    float normalMatch   = dot(centerNormal, historyNormal);

    vec4 history = texture(sampler2D(textures[nonuniformEXT(pc.historyIndex)],
                                     samplers[SAMPLER_CLAMP_LINEAR]),
                           historyUV);

    /* Neighbourhood variance statistics (3×3, per-channel over rgb). */
    vec3  rgbMin = current.rgb;
    vec3  rgbMax = current.rgb;
    vec3  rgbSum = current.rgb;
    vec3  rgbSq  = current.rgb * current.rgb;
    float alphaMin = current.a;
    float alphaMax = current.a;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            if (x == 0 && y == 0) continue;
            ivec2 sc = clamp(coord + ivec2(x, y),
                             ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
            vec4 sv = texelFetch(sampler2D(textures[nonuniformEXT(pc.currentIndex)],
                                           samplers[SAMPLER_NEAREST]),
                                 sc, 0);
            rgbMin    = min(rgbMin, sv.rgb);
            rgbMax    = max(rgbMax, sv.rgb);
            rgbSum   += sv.rgb;
            rgbSq    += sv.rgb * sv.rgb;
            alphaMin  = min(alphaMin, sv.a);
            alphaMax  = max(alphaMax, sv.a);
        }
    }

    float speed = length(velocity);

    /* ── Thin-geometry detection (depth gradient). */
    float depthGrad = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            if (x == 0 && y == 0) continue;
            ivec2 sc = clamp(coord + ivec2(x, y),
                             ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
            float sd = texelFetch(sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                                            samplers[SAMPLER_NEAREST]),
                                  sc, 0).r;
            if (sd > 0.0) {
                float sLinZ = linearizeDepth(sd);
                depthGrad += abs(centerLinZ - sLinZ);
            }
        }
    }
    depthGrad /= 8.0;
    float isThinGeometry = smoothstep(0.02, 0.1, depthGrad / max(centerLinZ, 1e-4));

    /* ── Edge pixel detection (alpha-cutout boundary). */
    float edgeWeight = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            if (x == 0 && y == 0) continue;
            ivec2 sc = clamp(coord + ivec2(x, y),
                             ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
            float sd = texelFetch(sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                                            samplers[SAMPLER_NEAREST]),
                                  sc, 0).r;
            if (sd == 0.0) {
                edgeWeight += 1.0;
            }
        }
    }
    /* Only treat as edge if: (a) clear edge signal AND (b) thin geometry.
     * Prevents false positives on horizon lines or terrain boundaries. */
    float isEdge = smoothstep(0.0, 0.5, edgeWeight / 8.0) * smoothstep(0.3, 0.8, isThinGeometry);

    vec3  rgbMean = rgbSum / 9.0;
    float gamma   = mix(1.0, 2.5, smoothstep(0.5, 4.0, speed));
    /* Per-channel variance clip. */
    vec3 rgbSigma = sqrt(max(rgbSq / 9.0 - rgbMean * rgbMean, vec3(0.0)));
    vec3 varMin   = max(rgbMean - gamma * rgbSigma, rgbMin);
    vec3 varMax   = min(rgbMean + gamma * rgbSigma, rgbMax);
    history.rgb   = clamp(history.rgb, varMin, varMax);
    history.a     = clamp(history.a, alphaMin, alphaMax);

    float disocclusion = smoothstep(0.01, 0.06, relDepthDiff) +
                         (1.0 - smoothstep(0.80, 0.95, normalMatch));
    disocclusion = clamp(disocclusion, 0.0, 1.0);
    /* Reduce disocclusion for thin geometry and edge pixels. */
    disocclusion *= mix(1.0, 0.3, isThinGeometry);
    disocclusion *= mix(1.0, 0.1, isEdge);

    /* GI color shifts are larger than occlusion-factor shifts, so the
     * base blend is slightly looser than the contact shadow's. */
    float baseBlend      = mix(0.10, 0.05, isThinGeometry);
    float velocityWeight = smoothstep(0.5, 4.0, speed) * 0.12;
    float blend          = max(baseBlend, disocclusion + velocityWeight);
    blend                = min(blend, 0.20);  /* hard cap */

    vec4 result = mix(history, current, clamp(blend, 0.0, 1.0));
    result.rgb  = clamp(result.rgb, vec3(0.0), vec3(64.0));
    result.a    = clamp(result.a, 0.0, 1.0);
    imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord, result);
}
