#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_ARB_shading_language_include : enable

// SSGI — screen-space global illumination (raw raymarch).
// h3r3tic "Depth buffer raymarching" (gist heretic-raymarch-hlsl, method 1)
// with normal-threshold edge detection (method 3) on hit.
//
// Marches in view space: the reverse-Z depth buffer is linear in view Z,
// so the hit test is a plain linear-distance comparison (h3r3tic's
// thickness tolerance, scaled by distance).
//
// Inputs (see plans/ssgi.md for the freshness table):
//   depth        — current frame (depth pre-pass), rendered with jitter
//   worldNormal  — current frame (depth pre-pass, cleared to 0 for sky)
//   sceneColor   — previous frame's scene pass, rendered with prevJitter
//   material     — previous frame's scene pass, rendered with prevJitter
//
// Screen-space lookups are driven by the jittered `projection` (the same
// one that rasterised the current-frame depth buffer), so depth /
// world-normal lookups need no correction; the one-frame-old buffers
// are fetched at `suv - jitter - prevJitter`.
//
// Output: RGBA16F — rgb = bounce irradiance (Lambertian integral),
//         a   = confidence.

#include "../../includes/utils.shader"
#include "../../includes/globalset.shader"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint  sceneColorIndex;
    uint  depthIndex;
    uint  worldNormalIndex;
    uint  materialIndex;
    uint  outputIndex;
    uint  width;
    uint  height;
    float maxDistance;
} pc;

#define SSGI_RAYS 8
#define SSGI_STEPS 64
#define SSGI_NORMAL_THRESHOLD 0.1
#define SSGI_ORIGIN_BIAS 0.01

vec2 ssgiSizePx(void) {
    return vec2(pc.width, pc.height);
}

float ssgiLinearizeDepth(float d) {
    float N = sceneBuffer.cameras[0].zNear;
    float F = sceneBuffer.cameras[0].zFar;
    return (N * F) / max(N + (F - N) * d, 1e-7);
}

/* Depth lookup in the jittered grid (suv produced by the jittered
 * projection — the one the current-frame depth was rasterised with). */
float ssgiSampleDepth(vec2 suv) {
    vec2  jp = clamp(suv, vec2(0.0), vec2(1.0));
    ivec2 c  = clamp(ivec2(jp * ssgiSizePx()),
                     ivec2(0), ivec2(int(ssgiSizePx().x) - 1, int(ssgiSizePx().y) - 1));
    return texelFetch(
        sampler2D(textures[nonuniformEXT(pc.depthIndex)], samplers[SAMPLER_CLAMP_NEAREST]),
        c, 0).r;
}

/* Pixel coord of one-frame-old buffers (previous frame's jittered grid).
 * `suv` is the current-frame jittered UV (from the jittered projection);
 * the point's unjittered UV is `suv + jitter`, which last frame
 * rasterised at `suv + jitter - prevJitter`. */
ivec2 ssgiOldCoord(vec2 suv) {
    vec2 j = vec2(sceneBuffer.cameras[0].jitterX, sceneBuffer.cameras[0].jitterY);
    vec2 p = clamp(suv + j - vec2(sceneBuffer.cameras[0].prevJitterX,
                                  sceneBuffer.cameras[0].prevJitterY),
                   vec2(0.0), vec2(1.0));
    return ivec2(p * ssgiSizePx());
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) return;

    vec2 size = ssgiSizePx();
    vec2 uv   = (vec2(coord) + 0.5) / size;

    /* ── Origin pixel ─────────────────────────────────────────────── */

    float depth = texelFetch(
        sampler2D(textures[nonuniformEXT(pc.depthIndex)], samplers[SAMPLER_CLAMP_NEAREST]),
        coord, 0).r;
    if (depth == 0.0) {
        imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord, vec4(0.0));
        return;
    }

    float metallic = texelFetch(
        sampler2D(textures[nonuniformEXT(pc.materialIndex)], samplers[SAMPLER_CLAMP_NEAREST]),
        coord, 0).g;
    if (metallic > 0.99) {
        imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord, vec4(0.0));
        return;
    }

    /* Jitter-stable world position (SSR pattern: unjittered UV +
     * invViewProjectionNoJitter). */
    vec2 jitter     = vec2(sceneBuffer.cameras[0].jitterX, sceneBuffer.cameras[0].jitterY);
    vec2 unjitterUv = uv + jitter;
    vec2 ndc        = vec2(unjitterUv.x * 2.0 - 1.0, 1.0 - unjitterUv.y);
    vec4 worldH     = sceneBuffer.cameras[0].invViewProjectionNoJitter * vec4(ndc, depth, 1.0);
    vec3 worldPos   = worldH.xyz / worldH.w;

    vec3 N = normalize(texelFetch(
        sampler2D(textures[nonuniformEXT(pc.worldNormalIndex)], samplers[SAMPLER_CLAMP_NEAREST]),
        coord, 0).rgb);
    if (N == vec3(0.0)) N = vec3(0.0, 1.0, 0.0);

    /* ── Hemisphere basis + per-frame jitter ──────────────────────── */

    vec3 T = normalize(cross(N, abs(N.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
    vec3 B = cross(N, T);

    uint   frame = sceneBuffer.cameras[0].frameIndex;
    vec2   n     = hash2(vec2(coord) + vec2(float(frame), 0.0));
    float  rotAz = n.x;
    float  rotEl = n.y;

    mat3  viewRot = mat3(sceneBuffer.cameras[0].view);
    mat4  proj    = sceneBuffer.cameras[0].projection;
    vec3  origin  = worldPos + N * SSGI_ORIGIN_BIAS;
    vec3  Oview   = (sceneBuffer.cameras[0].view * vec4(origin, 1.0)).xyz;
    float stepLen = pc.maxDistance / float(SSGI_STEPS);

    vec3 colorSum     = vec3(0.0);
    int  offscreenCnt = 0;

    for (int i = 0; i < SSGI_RAYS; i++) {
        float az     = 6.2831853 * (float(i) + rotAz) / float(SSGI_RAYS);
        float elFrac = fract((float(i) + rotEl) / float(SSGI_RAYS));
        float sinEl  = sqrt(max(elFrac, 0.0));
        float cosEl  = sqrt(max(1.0 - elFrac, 0.0));
        vec3  D      = normalize(T * (cos(az) * sinEl) + B * (sin(az) * sinEl) + N * cosEl);
        vec3  Dview  = viewRot * D;

        float hitT   = -1.0;
        float hitCos = 0.0;
        vec2  hitSuv = vec2(0.0);
        bool  rayOffscreen = false;

        for (int s = 1; s <= SSGI_STEPS; s++) {
            float t = float(s) * stepLen;
            vec3  P = Oview + Dview * t;
            if (P.z > -0.1) {
                rayOffscreen = true;
                break;
            }

            vec4 clip = proj * vec4(P, 1.0);
            if (clip.w <= 0.0) {
                rayOffscreen = true;
                break;
            }
            vec3 sNdc = clip.xyz / clip.w;
            vec2 suv  = vec2(sNdc.x * 0.5 + 0.5, 0.5 - sNdc.y);
            if (suv.x < 0.0 || suv.x > 1.0 || suv.y < 0.0 || suv.y > 1.0) {
                rayOffscreen = true;
                break;
            }

            float bufD = ssgiSampleDepth(suv);
            if (bufD == 0.0) break; /* sky — no occluder */

            float dBuf = ssgiLinearizeDepth(bufD);
            float dRay = -P.z;

            /* Surface at or in front of the ray sample (within the
             * distance-scaled thickness tolerance → grazing crossings
             * still register as h3r3tic prescribes). */
            if (dBuf - dRay < max(0.05, t * 0.01)) {
                /* Normal-threshold edge detection on the hit pixel:
                 * reject grazing hits (kills silhouette artefacts and
                 * grazing self-intersections).  Sky pixels carry a zero
                 * normal and are rejected the same way. */
                vec3  Nh   = normalize(texelFetch(
                    sampler2D(textures[nonuniformEXT(pc.worldNormalIndex)],
                              samplers[SAMPLER_CLAMP_NEAREST]),
                    ivec2(clamp(suv, vec2(0.0), vec2(1.0)) * ssgiSizePx()),
                    0).rgb);
                float nHit = dot(Nh, -D);
                if (nHit < SSGI_NORMAL_THRESHOLD) break;

                hitT   = t;
                hitCos = nHit;
                hitSuv = suv;
                break;
            }
        }

        if (rayOffscreen) offscreenCnt++;
        if (hitT < 0.0)   continue;

        /* ── Gather (previous frame's lit color ≈ outgoing radiance) */

        ivec2 hc = ssgiOldCoord(hitSuv);
        vec3  hitColor = texelFetch(
            sampler2D(textures[nonuniformEXT(pc.sceneColorIndex)], samplers[SAMPLER_CLAMP_LINEAR]),
            hc, 0).rgb;

        /* Kill the specular part; the Lambertian assumption covers the
         * view-direction mismatch of the one-frame-old color. */
        float hitMetallic = texelFetch(
            sampler2D(textures[nonuniformEXT(pc.materialIndex)], samplers[SAMPLER_CLAMP_NEAREST]),
            hc, 0).g;
        vec3 diffuse = max(hitColor, vec3(0.0)) * (1.0 - hitMetallic);

        float wOrigin  = max(dot(N, D), 0.0);
        float distFade = 1.0 - smoothstep(0.5, 1.0, hitT / pc.maxDistance);

        colorSum += diffuse * hitCos * wOrigin * distFade;
    }

    /* ── Confidence ───────────────────────────────────────────────── */

    /* Origin depth-edge fade (radius 1, current-frame depth): the
     * depth buffer is unreliable next to silhouettes / alpha-cutout
     * boundaries, so the hemisphere estimate is too. */
    float centerLinZ   = ssgiLinearizeDepth(depth);
    float edgeMaxDelta = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            if (x == 0 && y == 0) continue;
            ivec2 sc = clamp(coord + ivec2(x, y),
                             ivec2(0), ivec2(int(size.x) - 1, int(size.y) - 1));
            float sd = texelFetch(
                sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                          samplers[SAMPLER_CLAMP_NEAREST]),
                sc, 0).r;
            if (sd == 0.0) {
                edgeMaxDelta = max(edgeMaxDelta, centerLinZ);
                continue;
            }
            edgeMaxDelta = max(edgeMaxDelta,
                               abs(centerLinZ - ssgiLinearizeDepth(sd)));
        }
    }
    float edgeFade = 1.0 - smoothstep(0.0, max(0.05, centerLinZ * 0.1), edgeMaxDelta);

    /* Offscreen rays carry no information: fade with their fraction. */
    float offscreenFade = 1.0 - smoothstep(0.25, 0.75, float(offscreenCnt) / float(SSGI_RAYS));

    float confidence = clamp(edgeFade * offscreenFade, 0.0, 1.0);

    /* ── Integrate (uniform-hemisphere: 2π/n / π = 2/n) ───────────── */

    vec3 radiance = (2.0 / float(SSGI_RAYS)) * colorSum;
    radiance      = clamp(radiance, vec3(0.0), vec3(64.0));

    imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord,
               vec4(radiance, confidence));
}
