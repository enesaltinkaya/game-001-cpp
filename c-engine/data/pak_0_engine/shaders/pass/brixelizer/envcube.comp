#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_ARB_shading_language_include : enable

// Brixelizer GI environment cube (plans/brixelizer-gi.md Step 6.2):
// evaluates the shared procedural sky (includes/sky.shader, the same
// function skybox.frag renders) into a 128x128x6 RGBA16F cube. GI samples
// it as a world-space samplerCube (SampleEnvironmentMap in the FFX GLSL),
// so the face/direction table below is the standard cube-map texel
// convention: texel (u,v) of a face stores the direction whose (sc,tc)/ma
// equals (2u-1, 2v-1) per face (OpenGL cube face table).

#include "../../includes/utils.shader"
#include "../../includes/globalset.shader"
#include "../../includes/sky.shader"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint outputIndex;
    uint faceSize;
};

void main() {
    uvec3 g = gl_GlobalInvocationID;
    if (g.x >= faceSize || g.y >= faceSize || g.z >= 6u) return;

    float s = (float(g.x) + 0.5) / float(faceSize) * 2.0 - 1.0;
    float t = (float(g.y) + 0.5) / float(faceSize) * 2.0 - 1.0;

    vec3 dir;
    if (g.z == 0u)      dir = vec3( 1.0, -t, -s);  // +X
    else if (g.z == 1u) dir = vec3(-1.0, -t,  s);  // -X
    else if (g.z == 2u) dir = vec3( s,  1.0,  t);  // +Y
    else if (g.z == 3u) dir = vec3( s, -1.0, -t);  // -Y
    else if (g.z == 4u) dir = vec3( s, -t,  1.0);  // +Z
    else                dir = vec3(-s, -t, -1.0);  // -Z

    vec3 color = skyEvaluate(normalize(dir));
    imageStore(storageImagesCube[outputIndex], ivec3(g), vec4(color, 1.0));
}
