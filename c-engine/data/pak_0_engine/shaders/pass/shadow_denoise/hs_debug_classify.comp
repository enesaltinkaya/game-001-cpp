#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_ARB_shading_language_include : enable

#include "../../includes/utils.shader"
#include "../../includes/globalset.shader"

/* Temporary diagnostic: per-pixel replica of the FFX shadow classifier
 * (non-inverted depth, classify-by-cascades, bRejectLitPixels=true).
 * Output R8G8B8A8 per pixel:
 *   R = definitely lit      (minD >= depthCmp)
 *   G = inside a cascade quad
 *   B = definitely shadow   (maxD <= depthCmp)
 *   A = clamp((minD - depthCmp) * 10, 0, 1)   margin below the lit threshold
 * The FFX 24-tap Poisson disc is approximated by a 5x5 grid.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint  depthIndex;          /* scene depth (D32, sampled pool) */
    uint  outIndex;           /* debug output (storage pool)     */
    uint  width;
    uint  height;
    float sunSizeLightSpace;
    float blockerOffset;
    float cascadeSize;        /* shadow map texels */
    float pad;
    mat4  lightView;          /* CSM shared light-view */
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;

    const float csz = pc.cascadeSize;

    float depth = texelFetch(textures[nonuniformEXT(pc.depthIndex)], p, 0).r;
    if (depth <= 0.0) {
        /* sky / empty (reversed-Z scene depth: empty = 0.0, near = 1.0) */
        imageStore(storageImages[nonuniformEXT(pc.outIndex)], p, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec2 uv = (vec2(float(p.x), float(p.y)) + 0.5) / vec2(float(pc.width), float(pc.height));
    vec2 ndc = vec2(uv.x, 1.0 - uv.y) * 2.0 - 1.0;
    vec4 worldH = sceneBuffer.cameras[0].invViewProjectionNoJitter * vec4(ndc, depth, 1.0);
    vec3 worldPos = worldH.xyz / worldH.w;

    vec3 lvPos = (pc.lightView * vec4(worldPos, 1.0)).xyz;

    /* Cascade selection (FFX): first cascade whose shadow-UV quad contains the
     * point; if none does, the last-tested cascade's coord is used but
     * cascadeIndex stays 0. */
    int  selCascade = 0;
    vec2 shadowCoord = vec2(0.0);
    float shadowZ = 0.0;
    for (int i = 0; i < 4; i++) {
        if (i >= int(sceneBuffer.shadow.cascadeCount)) break;
        vec4 clip = sceneBuffer.shadow.shadowViewProjection[i] * vec4(worldPos, 1.0);
        vec3 c = clip.xyz / clip.w;
        shadowCoord = vec2(c.x * 0.5 + 0.5, 0.5 - c.y * 0.5);
        shadowZ = c.z;
        if (shadowCoord.x > 0.0 && shadowCoord.y > 0.0 &&
            shadowCoord.x < 1.0 && shadowCoord.y < 1.0) {
            selCascade = i;
            break;
        }
    }

    float depthCmp = shadowZ - pc.blockerOffset;

    /* Sun-disc radius in shadow-map texels (FFX: radius = sunSize * lvZ,
     * then * texels-per-light-unit * cascadeSize + 1). */
    mat4 cp = sceneBuffer.shadow.shadowViewProjection[selCascade];
    float uvPerLightUnit = 0.5 * max(abs(cp[0][0]), abs(cp[1][1]));
    float radiusCoord = abs(pc.sunSizeLightSpace * lvPos.z * uvPerLightUnit) * csz + 1.0;

    float minD = 1.0;
    float maxD = 0.0;
    bool anyTap = false;
    uint mapIndex = sceneBuffer.shadow.shadowMapIndex[selCascade];
    vec2 pixelUV = shadowCoord * csz;
    float step = radiusCoord / 2.0;
    for (int dy = -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            vec2 off = vec2(float(dx), float(dy)) * step + 0.5;
            vec2 sampleUV = pixelUV + off;
            if (sampleUV.x < 0.0 || sampleUV.y < 0.0 ||
                sampleUV.x >= csz || sampleUV.y >= csz)
                continue;
            float d = texelFetch(textures[nonuniformEXT(mapIndex)], ivec2(sampleUV), 0).r;
            maxD = max(maxD, d);
            minD = min(minD, d);
            anyTap = true;
        }
    }

    float inShadow = (maxD <= depthCmp) ? 1.0 : 0.0;
    float inLight = (minD >= depthCmp) ? 1.0 : 0.0;
    float inCascade = (shadowCoord.x > 0.0 && shadowCoord.y > 0.0 &&
                       shadowCoord.x < 1.0 && shadowCoord.y < 1.0) ? 1.0 : 0.0;
    float margin = clamp((minD - depthCmp) * 10.0, 0.0, 1.0);

    imageStore(storageImages[nonuniformEXT(pc.outIndex)], p,
               vec4(inLight, inCascade, inShadow, anyTap ? margin : 0.5));
}