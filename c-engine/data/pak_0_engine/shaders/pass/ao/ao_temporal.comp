#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_ARB_shading_language_include : enable

// XeGTAO temporal accumulation — the "G-TAO" half of the AO pipeline.
//
// Reprojects the previous accumulator with the velocity buffer, rejects
// stale history (out of bounds, no data, S-space depth change), clamps
// the reprojected history into the current frame's 3×3 min/max box
// (kills ghosting; built at the reprojected position so the box is stable
// across jitter phases), then blends with an EMA (the per-frame ray-pass
// signal is first depth-gated spatially blurred — see below).
// Output: R16G16_SFLOAT, .r = accumulated occlusion, .g = S-space
// inverse view depth (0 = no data / sky).

#include "../../includes/utils.shader"
#include "../../includes/globalset.shader"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint aoIndex;
    uint prevIndex;
    uint outIndex;
    uint velocityIndex;
    uint depthIndex;
    uint width;
    uint height;
    float historyWeight;
    float depthThreshold;
} pc;

/* Inverse view-space depth S = 1 / viewDistance(d) — the taa.comp
 * convention (affine in reverse-Z; see the comment there).  Carried in
 * the accumulator's .g channel; 0 doubles as the "no data" sentinel. */
float depthToInv(float rawDepth) {
    if (rawDepth <= 0.0) return 0.0; /* empty (sky) — doubles as "no data" */
    float N = sceneBuffer.cameras[0].zNear;
    float F = sceneBuffer.cameras[0].zFar;
    return (N + (F - N) * rawDepth) / (N * F);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) {
        return;
    }

    vec2 res = vec2(pc.width, pc.height);
    vec2 uv  = (vec2(coord) + 0.5) / res;

    /* Sky pixels: no occlusion, no history. */
    float depth = texelFetch(
        sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                  samplers[SAMPLER_CLAMP_NEAREST]),
        coord, 0).r;
    if (depth == 0.0) {
        imageStore(storageImages[nonuniformEXT(pc.outIndex)], coord,
                   vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }

    /* Current frame's per-pixel AO from the ray pass, spatially blurred:
     * 5×5 Gaussian gated by S-space (inverse view depth) continuity, the
     * fast bilateral step of the XeGTAO pipeline.  Same-surface taps
     * blend; taps across a silhouette keep near-zero weight (exp decay of
     * |ΔS|) so occlusion never smears over an occluder edge.  Feeding the
     * blurred value to the temporal blend is what turns the speckled,
     * hard-edged per-frame band into a soft contact shadow. */
    float currS = depthToInv(depth);

    const float G5[25] = {
        1.0f,  4.0f,  6.0f,  4.0f,  1.0f,
        4.0f, 16.0f, 24.0f, 16.0f,  4.0f,
        6.0f, 24.0f, 36.0f, 24.0f,  6.0f,
        4.0f, 16.0f, 24.0f, 16.0f,  4.0f,
        1.0f,  4.0f,  6.0f,  4.0f,  1.0f};
    float blurSum = 0.0;
    float blurWgt = 0.0;
    for (int dy = -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            ivec2 n = coord + ivec2(dx, dy);
            if (n.x < 0 || n.y < 0 || n.x >= int(pc.width) ||
                n.y >= int(pc.height)) {
                continue;
            }
            float v = texelFetch(
                sampler2D(textures[nonuniformEXT(pc.aoIndex)],
                          samplers[SAMPLER_CLAMP_NEAREST]),
                n, 0).r;
            float s = depthToInv(texelFetch(
                sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                          samplers[SAMPLER_CLAMP_NEAREST]),
                n, 0).r);
            float g  = G5[(dy + 2) * 5 + (dx + 2)];
            float dw = exp(-abs(s - currS) * 50.0);
            blurSum += v * g * dw;
            blurWgt += g * dw;
        }
    }
    float curr = (blurWgt > 1e-6) ? blurSum / blurWgt : 1.0;

    /* ── Reprojection ── */
    vec2 mv     = texture(
        sampler2D(textures[nonuniformEXT(pc.velocityIndex)],
                   samplers[SAMPLER_CLAMP_NEAREST]),
        uv).xy;
    vec2 prevUv = uv - mv / res;
    bool prevValid =
        all(greaterThanEqual(prevUv, vec2(0.0))) &&
        all(lessThanEqual(prevUv, vec2(1.0)));

    vec2 prevData = texture(
        sampler2D(textures[nonuniformEXT(pc.prevIndex)],
                  samplers[SAMPLER_CLAMP_LINEAR]),
        prevUv).rg;
    float prevA = prevData.x;
    float prevS = max(prevData.y, 0.0);

    /* ── Rejection ── */
    float reject = 0.0;
    if (prevS < 1e-6) {
        /* No history data (right after create/resize/clear): fall back to
         * the current frame. */
        reject = 1.0;
    } else {
        /* Relative S-space depth change: 0 for a static surface, ~100%
         * for any surface → sky disocclusion (prevS > 0 vs. sky handled
         * above).  Fire only on real disocclusions, never on depth noise. */
        float sMax      = max(currS, prevS);
        float depthDiff = (sMax > 1e-5) ? abs(currS - prevS) / sMax : 0.0;
        reject = max(reject,
                     smoothstep(pc.depthThreshold * 0.5, pc.depthThreshold,
                                depthDiff));
    }

    /* ── 3×3 min/max clamp of the reprojected history against the
     *    current frame's neighbourhood — the standard XeGTAO ghost
     *    removal.  The history is resampled at the reprojected position,
     *    so the clamp box is built from the current frame's taps at that
     *    same reprojected position (temporally stable across jitter
     *    phases, TAA convention).  Clamping the history (not the current
     *    sample) is what lets a cleared (all 1.0) history bootstrap:
     *    the current frame pulls the value in, the box only constrains
     *    stale history.  Taps are only admitted when they sit on the
     *    same surface (relative S-space change < ~2%, sky excluded), so a
     *    silhouette-adjacent noisy neighbour cannot shrink the box. */
    float nMin = curr;
    float nMax = curr;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            vec2 nuv = clamp(prevUv + vec2(float(dx), float(dy)) / res,
                             vec2(0.0), vec2(1.0));
            float s = depthToInv(texture(
                sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                          samplers[SAMPLER_CLAMP_NEAREST]),
                nuv).r);
            if (s < 1e-6) continue;  /* sky neighbour */
            if (abs(s - currS) >= 0.02 * max(s, currS)) continue;
            float v  = texture(
                sampler2D(textures[nonuniformEXT(pc.aoIndex)],
                          samplers[SAMPLER_CLAMP_NEAREST]),
                nuv).x;
            nMin     = min(nMin, v);
            nMax     = max(nMax, v);
        }
    }
    float clampedPrev = clamp(prevA, nMin, nMax);

    /* ── Temporal blend ── */
    float weight = pc.historyWeight * (1.0 - reject);
    if (!prevValid) {
        weight = 0.0;
    }
    float accum = mix(clampedPrev, curr, 1.0 - weight);

    imageStore(storageImages[nonuniformEXT(pc.outIndex)], coord,
               vec4(accum, currS, 0.0, 0.0));
}