#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_ARB_shading_language_include : enable

// XeGTAO (GPU-GTAO, NVIDIA GDC 2015) ray pass with HiZ early-out.
//
// Per pixel, RAY_COUNT jittered disk rays are marched outward with doubling
// steps; each step projects to screen and tests the HiZ mip chain (O(log N)
// depth samples instead of a linear march).  The disk fans toward the
// dominant light (the directional sun), so occlusion is light-consistent
// instead of view-dependent (a camera-facing disk is TAO and produces a
// dark silhouette ring tracing every canopy edge — background pixels behind
// the tree false-hit the canopy when marching toward the camera).  Each hit
// is converted to a horizon angle and integrated into a noisy single-frame
// occlusion factor (0 = occluded, 1 = open), written to the R8 per-frame
// buffer.  The temporal pass (ao_temporal.comp) accumulates this into a
// stable signal.

#include "../../includes/utils.shader"
#include "../../includes/globalset.shader"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define MAX_HIZ_MIPS 16

layout(push_constant) uniform PushConstants {
    uint depthIndex;
    uint normalsIndex;
    uint outputIndex;
    uint width;
    uint height;
    uint hizMipCount;
    uint _pad;
    uint hizMipIndex[MAX_HIZ_MIPS];
} pc;

// ── Tunables ─────────────────────────────────────────────────────────
#define RAY_COUNT     32   // disk rays per pixel
#define MAX_STEPS     16   // doubling march iterations (HiZ early-out)
// Widen the cone from ~10° to ~29°.  A near-sun-only cone makes occlusion
// binary — a ground pixel either sits inside the occluder's sun-silhouette
// (all rays hit → AO floor, black band) or outside it (no rays hit → full
// 1.0) — which is what produced the hard-edged black ring around the
// player and the distant tree halos.  A wider cone spreads the occluder's
// shadow over a graded fraction of the disk, giving a soft contact
// falloff while staying light-consistent (centered on the sun axis).
#define DISK_RADIUS   0.55
#define HORIZON_SCALE 0.45 // master AO strength (was 0.6 — combined with the
                           // ≤2.0 per-ray weight it saturated pixels to the
                           // floor; halved for a subtle pass)
#define AO_FLOOR      0.5  // no pixel darkens by more than 50% (was 0.35 —
                           // 65% read as a black blob on lit grass)
// March range was clamp(0.05*dist, 0.3, 20): 0.3 m around a 4 m-close
// player but up to 20 m on distant trees (the halo radius).  Grow it
// slowly with distance and cap it: tight contact shadows near, sensible
// trunk-canopy range far, never scene-scale.
#define MAX_DIST_SCALE 0.012
#define MAX_DIST_MIN  0.1  // march range clamp, metres
#define MAX_DIST_MAX  4.0

// Project world position to screen: returns (uv.xy, ndc.z) — the unjittered
// convention from ssr.comp (stable across jitter phases; NDC z is
// jitter-invariant since jitter only shifts clip.xy).
vec3 projectToScreen(vec3 worldPos) {
    vec4 clip = sceneBuffer.cameras[0].viewProjectionNoJitter * vec4(worldPos, 1.0);
    if (clip.w <= 0.0) return vec3(-1.0);
    vec3 ndc = clip.xyz / clip.w;
    vec2 uv  = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    return vec3(uv, ndc.z);
}

// The depth/HiZ chain is built from the jittered render, so lookups driven
// by unjittered UVs must undo the jitter first (ssr.comp convention).
vec2 jitteredUv(vec2 uv) {
    return uv - vec2(sceneBuffer.cameras[0].jitterX,
                     sceneBuffer.cameras[0].jitterY);
}

// Fetch a HiZ mip (.r = min/farthest, .g = max/closest, reverse-Z) at an
// unjittered UV.  Each mip is a single-level image view registered in the
// bindless pool, so the texel index is computed per-mip.
vec2 fetchHiZ(uint mip, uint poolIndex, vec2 uv) {
    uint w = max(pc.width >> mip, 1u);
    uint h = max(pc.height >> mip, 1u);
    vec2  uvj    = clamp(jitteredUv(uv), vec2(0.0), vec2(1.0));
    ivec2 icoord = clamp(ivec2(uvj * vec2(w, h)),
                         ivec2(0), ivec2(int(w) - 1, int(h) - 1));
    return texelFetch(sampler2D(textures[nonuniformEXT(poolIndex)],
                                samplers[SAMPLER_CLAMP_NEAREST]),
                      icoord, 0).rg;
}

// Reverse-Z window depth → view-space distance.  The camera uses a finite
// reversed-Z projection (glm_perspective with near/far swapped), for which
// d(rho) = B/rho - A with A = zNear/(zFar - zNear), B = zNear*zFar/(zFar -
// zNear); the exact inverse below stays correct to the far plane (the
// naive zNear/d drifts by hundreds of metres at kilometre range).
float viewZ(float d) {
    float N = sceneBuffer.cameras[0].zNear;
    float F = sceneBuffer.cameras[0].zFar;
    float A = N / (F - N);
    float B = N * F / (F - N);
    return B / (d + A);
}

// Base-2 Halton (bit reversal) — per-ray equidistributed angles.
float halton2(int i) {
    uint x = uint(i);
    x = ((x & 0xaaaaaaaa) >> 1) | ((x & 0x55555555) << 1);
    x = ((x & 0xcccccccc) >> 2) | ((x & 0x33333333) << 2);
    x = ((x & 0xf0f0f0f0) >> 4) | ((x & 0x0f0f0f0f) << 4);
    x = ((x & 0xff00ff00) >> 8) | ((x & 0x00ff00ff) << 8);
    x = (x >> 16) | (x << 16);
    return float(x) / 4294967296.0;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) return;

    vec2 uv     = (vec2(coord) + 0.5) / vec2(pc.width, pc.height);
    vec2 jitter = vec2(sceneBuffer.cameras[0].jitterX,
                       sceneBuffer.cameras[0].jitterY);

    // ── Sample depth ─────────────────────────────────────────────────
    float depth = texelFetch(
        sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                  samplers[SAMPLER_CLAMP_NEAREST]),
        coord, 0).r;
    if (depth == 0.0) {
        // Sky: no occlusion.
        imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord,
                   vec4(1.0));
        return;
    }

    // ── Reconstruct world position / normal (unjittered-UV convention) ──
    vec2 unjitteredUv = uv + jitter;
    vec2 ndc          = vec2(unjitteredUv.x * 2.0 - 1.0, 1.0 - unjitteredUv.y * 2.0);
    vec4 worldH       = sceneBuffer.cameras[0].invViewProjectionNoJitter *
                        vec4(ndc, depth, 1.0);
    vec3 worldPos = worldH.xyz / worldH.w;

    vec2 normEnc = texelFetch(
        sampler2D(textures[nonuniformEXT(pc.normalsIndex)],
                  samplers[SAMPLER_CLAMP_NEAREST]),
        coord, 0).rg;
    vec3 N      = OctDecode(normEnc);
    vec3 N_view = normalize((sceneBuffer.cameras[0].view * vec4(N, 0.0)).xyz);

    // View-space quantities (camera at the origin, looking down −Z).
    vec3  viewPos   = (sceneBuffer.cameras[0].view * vec4(worldPos, 1.0)).xyz;
    float distToCam = length(viewPos);

    // ── Disk axis: fan toward the sun (light-consistent) ────────────
    // Occlusion is light-consistent: fanning the disk toward the sun darkens
    // the shadow side of an occluder (matching the cast shadowmap) and leaves
    // the lit side open.  This holds whether or not the sun is on-screen:
    // when the sun passes behind the camera the disk simply fans toward the
    // viewer, which degrades to a view-dependent contact shadow on the
    // shadow side (the G-TAO temporal pass stabilises the resulting
    // view-dependence).  A world-up "sky" fallback was tried here but
    // produced a disconnected dark ring on the LIT side of tall occluders
    // (nearly-vertical rays from a ground pixel pass through the
    // occluder's body at a distance, darkening a blob that is disconnected
    // from the contact point), so it was removed.
    // Fan the disk toward the sun.  The sun direction is world-space, so
    // transform it with `view` (world→view, same as N_view/viewPos above) —
    // NOT `invView` (view→world), which yields a bogus axis for any rotated
    // camera and fans the disk the wrong way (darkening the LIT side, i.e. a
    // silhouette ring disconnected from the contact point / shadowmap).
    vec3 sunView = normalize(
        (sceneBuffer.cameras[0].view * vec4(
            -sceneBuffer.directionalLight.direction.xyz, 0.0)).xyz);
    vec3 axis   = sunView;
    // Orthonormal disk basis around `axis` (Y reference unless degenerate).
    vec3 refDir = (abs(axis.y) < 0.99) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T      = normalize(cross(refDir, axis));
    vec3 B      = cross(axis, T);

    // ── March parameters ─────────────────────────────────────────────
    float maxDist   = clamp(MAX_DIST_SCALE * distToCam + 0.04,
                            MAX_DIST_MIN, MAX_DIST_MAX);
    // Thin-occluder slab: a HiZ "hit" only means the projected ray point
    // is behind SOME closer surface — that surface may be far off the ray
    // in world space (a near object's inflated screen silhouette over
    // background pixels: e.g. the player's head 1.5 m above the ground
    // darkening the terrain around it as if it were in contact).  The
    // recorded occluder is accepted only when it sits within this many
    // metres of the ray point along the VIEW ray; beyond that the ray
    // merely passed behind a foreground object and keeps marching.  The
    // slab grows with the march budget so far-range marches still accept
    // the thick, genuine occluders (tree canopies) they reach for, while
    // near-range contact AO (feet, grass, neck under hair) — whose
    // occluders sit ~0 m off the ray point — is untouched.
    float thicknessLimit = max(0.5, 0.75 * maxDist);
    // Self-intersection offset: keep it O(1 cm) near the camera and small
    // at range (the old 0.01*dist gave a 5 m offset at 500 m, voiding all
    // far-range contact AO).
    float startDist = 0.004 + 0.002 * distToCam;
    vec3  startPos  = worldPos + N * startDist;  // offset along the normal

    // Reverse-Z self-intersection bias, in NDC depth units.  Reverse-Z depth
    // is affine in distance (D = (zFar - z) / (zFar - zNear)), so a
    // world-space offset maps to a constant depth offset.  The ray starts
    // startDist along the normal and the first sample a further startDist
    // along the ray, so samples within ~2*startDist of the surface are
    // self-hits; the HiZ test below rejects hits inside that band.
    float selfBias  = (2.0 * startDist) /
                      (sceneBuffer.cameras[0].zFar -
                       sceneBuffer.cameras[0].zNear);

    // ── Per-frame blue-noise jitter (rotated golden-angle per frame) ──
    uint noiseIdx = sceneBuffer.ibl.blueNoiseIndex;
    vec2 bn;
    if (noiseIdx != 0u) {
        float fi    = float(sceneBuffer.cameras[0].frameIndex % 128);
        float angle = fi * 2.3999632;  // golden angle
        float c     = cos(angle);
        float s     = sin(angle);
        vec2 p      = mat2(c, -s, s, c) * (vec2(coord) / 128.0);
        bn = texture(sampler2D(textures[nonuniformEXT(noiseIdx)],
                               samplers[SAMPLER_CLAMP_NEAREST]),
                     fract(p + 0.5)).xy;
    } else {
        // IBL (and its blue-noise LUT) absent: cheap in-shader hashes;
        // one hash per component, the angle hash re-rolls each frame.
        uint fi = sceneBuffer.cameras[0].frameIndex;
        vec2 p  = vec2(coord);
        bn.x    = fract(dot(p, vec2(12.9898, 78.233)) + float(fi) * 0.618034);
        bn.y    = fract(dot(p, vec2(39.346, 11.1357)));
    }

    // ── Ray march ────────────────────────────────────────────────────
    float occl = 0.0;

    for (int i = 0; i < RAY_COUNT; i++) {
        // Stratified disk fanned toward the sun axis (light hemisphere,
        // where ambient light arrives).  Steps are lifted above the surface
        // and project in front of it, so the reverse-Z HiZ test (D > max ->
        // in front -> no hit) rejects the surface itself; only real
        // occluders above the tangent plane register, and the `parallel > 0`
        // gate below keeps below-plane hits out.
        float angle  = 6.2831853 * (halton2(i) + bn.x);
        float radius = DISK_RADIUS * sqrt((float(i) + bn.y) / float(RAY_COUNT));
        vec3  dirView = normalize(
            T * (cos(angle) * radius) + B * (sin(angle) * radius) + axis);

        // March in world space so every step projects through the same
        // unjittered VP as ssr.comp (one invView multiply per pixel).
        vec3 dirWorld = normalize(
            (sceneBuffer.cameras[0].invView * vec4(dirView, 0.0)).xyz);

        // Doubling march with HiZ early-out.  The first sample sits one
        // startDist along the ray (the normal offset of startPos cancels in
        // the hit vector below); t doubles per iteration.
        float t      = startDist;
        bool  hit    = false;
        float hitT   = 0.0;

        for (int s = 0; s < MAX_STEPS; s++) {
            if (t > maxDist) break;

            vec3 pos   = startPos + dirWorld * t;
            vec3 scr   = projectToScreen(pos);
            if (scr.x < 0.0) break;  // behind the camera
            if (scr.x > 1.0 || scr.y < 0.0 || scr.y > 1.0) break;  // off-screen:
                              // no depth info beyond the screen edge

            float D = scr.z;  // reverse-Z NDC depth (1 = near, 0 = far)
            if (D >= 1.0) break;  // in front of the near plane (past the cam)
            if (D <= 0.0) break;  // beyond the far plane (sky)

            // Mip selection: the step footprint in pixels at this distance;
            // +1 keeps the test conservative (covers the whole texel).
            float d   = distToCam + t;
            float pdu = pc.height * sceneBuffer.cameras[0].projection[1][1] /
                        (2.0 * d);
            uint mip = uint(clamp(floor(log2(t * pdu)) + 1.0, 0.0,
                                  float(uint(pc.hizMipCount) - 1u)));

            // HiZ test with pyramid descent.  Reverse-Z: .g = max = closest,
            // .r = min = farthest, and larger depth = closer to the camera.
            //   D < min - bias → behind every surface (beyond the self band)
            //                    → hit, IF the closest surface is within the
            //                      thin-occluder slab (see thicknessLimit)
            //   D > max        → in front of every surface (incl. our own)
            //                    → no hit, keep marching
            //   else           → ambiguous, descend to a finer mip
            uint m = mip;
            while (true) {
                vec2 hz = fetchHiZ(m, pc.hizMipIndex[m], scr.xy);
                if (D < hz.r - selfBias) {
                    // Candidate hit.  Gap = how far in front of the ray
                    // point the closest surface sits along the view ray;
                    // hz.g >= hz.r > D > 0 here, so viewZ() is well defined.
                    float gap = viewZ(D) - viewZ(hz.g);
                    if (gap <= thicknessLimit) {
                        hit  = true;
                        hitT = t;
                        break;
                    }
                    // Passed behind a foreground occluder.  Descend: a
                    // mixed cell may also hold a surface near the ray's
                    // own depth (a genuine occluder).  At mip 0 the cell is
                    // a single texel — nothing else to find, no hit.
                    if (m == 0u) break;
                    m--;
                    continue;
                }
                if (D > hz.g) {
                    break;  // in front of every surface — keep marching
                }
                if (m == 0u) {
                    break;  // finest mip, inside the self-bias band: no hit
                }
                m--;
            }
            if (hit) break;

            t *= 2.0;
        }

        if (!hit) continue;

        // ── Hit → horizon angle ──────────────────────────────────────
        // The normal offset of startPos cancels, so the hit vector from the
        // surface is dirView * hitT in view space.  Only hits ABOVE the
        // tangent plane (parallel > 0) occlude — the surface itself already
        // blocks the back hemisphere; hits below it (self-hits on flat
        // ground) contribute nothing.
        vec3  toHit    = dirView * hitT;
        float parallel  = dot(toHit, N_view);
        if (parallel <= 0.0) continue;
        float perp        = sqrt(max(dot(toHit, toHit) - parallel * parallel,
                                     0.0));
        float horizonAngle = atan(perp / parallel);

        // Weight: alignment with the disk axis (toward the sun).  With the
        // narrow default cone this is ≈ constant; it matters once the cone
        // is widened.  Range fade kills distant hits.
        float w    = 1.0 + dot(axis, dirView);
        float fade = 1.0 / (1.0 + (hitT / maxDist) * (hitT / maxDist));
        occl += w * horizonAngle * fade;
    }

    float ao = clamp(1.0 - (occl / float(RAY_COUNT)) * HORIZON_SCALE,
                     AO_FLOOR, 1.0);
    imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord,
               vec4(ao));
}