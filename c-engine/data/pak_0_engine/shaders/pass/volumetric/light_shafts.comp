#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_ARB_shading_language_include : enable

#include "../../includes/globalset.shader"
#include "../../includes/utils.shader"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint depthIndex;
    uint lightSourceIndex;
    uint outputIndex;
    uint width;
    uint height;
    uint fullWidth;
    uint fullHeight;
} pc;

/* ── helpers ─────────────────────────────────────────────────────── */

/* The output is rendered at half resolution but the shared depth image is
   full resolution, so convert the screen-space UV to a full-res texel. */
float readDepthUv(vec2 sUv) {
    ivec2 coord = clamp(ivec2(sUv * vec2(pc.fullWidth, pc.fullHeight)),
                        ivec2(0), ivec2(int(pc.fullWidth) - 1, int(pc.fullHeight) - 1));
    return texelFetch(
        sampler2D(textures[nonuniformEXT(pc.depthIndex)],
                  samplers[SAMPLER_NEAREST]),
        coord, 0).r;
}

/* Reconstruct world position from non-linear depth [0..1]. */
vec3 worldFromDepth(vec2 uv, float depth) {
    vec2 unj = uv + vec2(sceneBuffer.cameras[0].jitterX,
                          sceneBuffer.cameras[0].jitterY);
    vec2 ndc = vec2(unj.x * 2.0 - 1.0, 1.0 - unj.y * 2.0);
    vec4 wh  = sceneBuffer.cameras[0].invViewProjectionNoJitter
             * vec4(ndc, depth, 1.0);
    return wh.xyz / wh.w;
}

bool projectDirectionToUv(vec3 worldDir, out vec2 uv) {
    vec4 clip = sceneBuffer.cameras[0].viewProjectionNoJitter * vec4(worldDir, 0.0);
    if (clip.w <= 1e-5) return false;

    vec2 ndc = clip.xy / clip.w;
    uv = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    return true;
}

/* ── main ────────────────────────────────────────────────────────── */

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(pc.width, pc.height);

    /* Pixel depth — sky (0.0) is a light source, not a receiver. */
    float depth = readDepthUv(uv);
    if (depth == 0.0) {
        imageStore(storageImages[nonuniformEXT(pc.outputIndex)],
                   coord, vec4(0.0));
        return;
    }

    /* Camera ray. */
    vec3 worldPos   = worldFromDepth(uv, depth);
    vec3 camPos     = sceneBuffer.cameras[0].position.xyz;
    vec3 camToPixel = worldPos - camPos;
    vec3 rayDir     = normalize(camToPixel);

    /* Sun. */
    vec3  toSun        = normalize(-sceneBuffer.directionalLight.direction.xyz);
    vec3  sunColor     = sceneBuffer.directionalLight.color.rgb;
    float sunIntensity = sceneBuffer.directionalLight.direction.w;

    if (sunIntensity <= 0.0) {
        imageStore(storageImages[nonuniformEXT(pc.outputIndex)],
                   coord, vec4(0.0));
        return;
    }

    /* March parameters (screen-space interval). */
    const int   NUM_SAMPLES = 64;
    const float DENSITY     = 0.035;     /* per-sample attenuation       */

    /* Henyey-Greenstein phase (brighter toward sun). */
    float NdotV = dot(rayDir, toSun);
    float g     = 0.6;
    float phase = (1.0 - g * g) / (4.0 * PI * pow(1.0 + g * g - 2.0 * g * NdotV, 1.5));

    vec3  accumulated   = vec3(0.0);
    float transmittance = 1.0;

    /* Compute sun's screen-space UV position so we march toward the
       actual light source, not an arbitrary screen center. */
    vec2 sunUv;
    if (!projectDirectionToUv(toSun, sunUv)) {
        imageStore(storageImages[nonuniformEXT(pc.outputIndex)],
                   coord, vec4(0.0));
        return;
    }

    /* March in unjittered screen space for temporal stability, then convert
       samples back to the jittered render-target UV before reading depth and
       light-source images. */
    vec2 jitter  = vec2(sceneBuffer.cameras[0].jitterX,
                        sceneBuffer.cameras[0].jitterY);
    vec2 startUv = uv + jitter;

    /* March from the pixel UV toward the sun's screen position.
       Sky samples accumulate light; geometry samples are skipped
       to avoid projecting silhouettes of background objects. */
    vec2 dir    = sunUv - startUv;
    float dist  = length(dir);
    if (dist > 0.001) dir /= dist;

    /* Jitter sample positions per pixel and rotate that jitter each frame.
       Without per-frame variation the grain is a stable screen-space pattern,
       so temporal accumulation has nothing to average. */
    float frameJitter  = fract(float(sceneBuffer.cameras[0].frameIndex & 63u) * 0.61803398875);
    float sampleJitter = fract(hash(vec2(coord) + vec2(17.0, 43.0)) + frameJitter);

    for (int i = 0; i < NUM_SAMPLES; i++) {
        /* Screen-space sample position (toward sun). */
        float t          = (float(i) + sampleJitter) / float(NUM_SAMPLES);
        vec2 sUnjitterUv = startUv + dir * dist * t;
        vec2 sUv         = sUnjitterUv - jitter;

        if (any(lessThan(sUv, vec2(0.0))) || any(greaterThanEqual(sUv, vec2(1.0)))) {
            transmittance *= exp(-DENSITY);
            if (transmittance < 0.005) break;
            continue;
        }

        /* Read depth at the sample UV (full-res depth image). */
        float sDepth = readDepthUv(sUv);

        /* Accumulate sky samples (depth == 0.0).
           Skip geometry samples to avoid silhouette artifacts. */
        if (sDepth == 0.0) {
            vec3 lightSample = texture(
                sampler2D(textures[nonuniformEXT(pc.lightSourceIndex)],
                          samplers[SAMPLER_CLAMP_LINEAR]),
                sUv).rgb;
            accumulated += lightSample * transmittance;
        }

        /* Fixed exponential attenuation per sample. */
        transmittance *= exp(-DENSITY);
        if (transmittance < 0.005) break;
    }

    /* Phase modulation — shafts brighter when looking toward sun.  When the
       sun sits high the shafts point at the camera from overhead and wash
       the whole frame white even though it is not looking at the sun, so
       fade them out as the sun rises.  Low-sun shafts keep full strength. */
    float sunElevFade = 1.0 - smoothstep(0.3, 0.9, toSun.y);
    accumulated *= phase * sunIntensity * sunElevFade;

    /* Safety clamp. */
    accumulated = min(accumulated, sunColor * sunIntensity * 0.25);

    imageStore(storageImages[nonuniformEXT(pc.outputIndex)],
               coord, vec4(accumulated, 1.0));
}
